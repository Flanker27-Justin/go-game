# ============================================================
# 换行符与文本属性（解决 "LF will be replaced by CRLF" 警告，并防止
# 跨平台协作时出现整文件伪改动）
# 背景：仓库内 blob 已是纯 LF，而 core.autocrlf=true 会在下次 checkout 时
#       把工作区改写成 CRLF，产生"每一行都变了"的假 diff。这里统一规定：
#       仓库内一律 LF，工作区也一律 LF，任何平台行为一致。
# ============================================================

# 默认：自动识别文本文件，仓库内统一存 LF
* text=auto

# Git 自身配置文件也固定 LF（否则每次提交这两个文件都会报警告）
.gitattributes  text eol=lf
.gitignore      text eol=lf

# 源码与文档：显式指定工作区也用 LF（避免 Windows 上被改成 CRLF）
*.html   text eol=lf
*.htm    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.css    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf

# Windows 专用脚本才用 CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=lf
# 注意：这两个启动脚本的属性是有功能含义的，不要删——
#   · *.bat 用 CRLF：cmd.exe 对 LF-only 的批处理在变量展开（%~dp0）上有已知问题
#   · *.ps1 用 LF 且必须保留 UTF-8 BOM：Windows PowerShell 5.1 无 BOM 时会把中文按 ANSI 解析
#     （BOM 由编辑器/写入工具保留，git 不会删除；此处只固定行尾避免无谓改写）

# 归档件常带“双扩展名”（如 xxx.js.pre-require / gomoku.html.pre-engine-split），
# 上面按扩展名的规则匹配不到，这里统一按文本 + LF 处理。
work/archive/**  text eol=lf

# 二进制：禁止任何换行符转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.zip    binary

# package-lock 变更不参与 diff 展示（噪音大且无阅读价值）
package-lock.json  -diff linguist-generated
