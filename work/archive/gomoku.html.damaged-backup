 */
function resolveThreats(me = aiColor, opp = playerColor, skipOwnAttack, blockRushFours = true) {
  let aiBest = null;        // 鑷繁濞佽儊鏈€澶х殑绌轰綅
  let playerBest = null;    // 瀵规柟濞佽儊鏈€澶х殑绌轰綅
  const center = (boardSize - 1) / 2;

  // 闃插畧鍙嶅嚮鍔犲垎锛氭尅妫嬬偣鑻ュ悓鏃惰兘璁╂垜鏂瑰舰鎴愭椿涓?1)/鍐插洓(2)/娲诲洓(3)锛?  // 棰濆鍔犳潈锛岃 AI 灏介噺閫夆€滄棦鎸″緱浣忋€佸張鑳介『鍔垮弽鍑烩€濈殑浣嶇疆銆?  // 涓轰粈涔堝崟鐙啀鍔犱竴娆★紵scoreFor 鐨勮繘鏀诲垎鎶婁綆浠峰€艰繛绾匡紙娲讳竴/鐪犱簩锛変篃绠楄繘鏉ワ紝
  // 鑰岃繖閲屽彧濂栧姳鈥滅湡姝ｇ殑寮哄▉鑳佲€濓紙娲讳笁浠ヤ笂锛夛紝淇濊瘉闃插畧閫夌偣鐬勫噯鍙嶅嚮锛岃€屼笉鏄浂纰庤繛绾裤€?  const counterScore = (r, c) => {
    const lv = threatLevel(r, c, me);
    return lv >= 1 ? lv * 12000 : 0;
  };

  // 鍚岀瓑绾у▉鑳佺敤鍚彂寮忓垎 + 闃插畧鍙嶅嚮鍒?+ 涓績鍋忓ソ鍐宠儨锛?  // 杩涙敾鐐瑰彧鐪嬪惎鍙戝紡鍒嗕笌涓績鍋忓ソ锛涢槻瀹堢偣棰濆鍙犲姞鍙嶅嚮鍒嗭紝閫夆€滆兘璧㈢殑浣嶇疆鈥濆幓鎸°€?  const tieScore = (r, c, defensive) =>
    scoreFor(r, c, me, opp) + (defensive ? counterScore(r, c) : 0)
    + (countThreats(r, c, me) >= 2 ? 20000 : 0)   // 鍚岀瓑绾у▉鑳侀噷浼樺厛鈥滀竴鎵嬪弻濞佽儊鈥濈殑鏉€鎷涚偣
    - (Math.abs(r - center) + Math.abs(c - center)) * 0.5;
  const consider = (cur, r, c, lv, defensive) => {
    if (!cur || lv > cur.lv || (lv === cur.lv && tieScore(r, c, defensive) > tieScore(cur.r, cur.c, defensive))) {
