/**
 * VCF锛圴ictory by Continuous Fours锛岃繛缁啿鍥涳級鏉€妫嬫娴嬨€? * 鎬濊矾锛氳繛缁笅鈥滃啿鍥涒€濓紝瀵规柟姣忎竴姝ラ兘鍙兘琚揩鎸¤繖涓啿鍥涳紝
 * 涓€璺妸瀵规柟甯﹀埌鈥滄椿鍥?浜旇繛鈥濅负姝⑩€斺€旇繖灏辨槸涓€鏉″己鍒惰儨搴忓垪銆? * 鍛戒腑鏃惰繑鍥炲綋鍓嶈繖涓€姝ワ紙棣栦釜寮哄埗钀界偣锛夛紝骞舵妸瀹屾暣璺緞瀛樺叆 lastVcfPath 渚涙暀瀛﹀睍绀恒€? * @param {number} color 杩涙敾鏂归鑹? * @param {number} maxPlies 鏈€澶ф悳绱㈠眰鏁帮紙姣忓眰 = 宸辨柟涓€鎵?+ 瀵规柟涓€鎵嬶級
 * @returns {Array|null} [r, c]
 */
function findVcfWin(color, maxPlies = VCF_MAX_PLIES) {
  const opp = color === BLACK ? WHITE : BLACK;
  lastVcfPath = null;
  // 瀵规柟宸插彲涓€姝ユ垚浜?鈫?VCF 鍓嶆彁涓嶆垚绔嬶紙蹇呴』鍏堥槻瀹堬級锛?  // 鎴戞柟宸插彲涓€姝ユ垚浜?鈫?浜ょ粰 findImmediateWin 澶勭悊鍗冲彲銆?  if (findImmediateWin(opp) || findImmediateWin(color)) return null;
  // 璁板綍鈥滄渶鐭繛鏉€璺緞鈥濓細鍚屼竴灞€闈㈠線寰€瀛樺湪澶氭潯 VCF 璺嚎锛屼紭鍏堣蛋鎵嬫暟鏈€鐭殑锛?  // 鍥犱负瀵规柟琚揩搴旂殑鎵嬫暟瓒婂皯锛岃秺娌℃湁鏈轰細涓€斿弽鏉€锛屾潃妫嬭秺绋炽€?  const vcf = { nodes: 0, t0: performance.now(), budget: VCF_TIME_BUDGET_MS, cur: [], bestLen: Infinity, bestPath: null };
  if (vcfSearch(color, opp, maxPlies, vcf, null, null) > 0 && vcf.bestPath && vcf.bestPath.length) {
    lastVcfPath = vcf.bestPath.slice();
    return vcf.bestPath[0];
  }
  return null;
}

/**
 * VCF 閫掑綊涓讳綋銆? * @param {number|null} lastR 涓婁竴鎵嬭惤鐐硅锛堢敤浜庡揩閫熷垽浜旓紝null 琛ㄧず鏍硅妭鐐癸級
