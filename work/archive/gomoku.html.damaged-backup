}

/** 澶勭悊鏈嶅姟鍣ㄤ笅鍙戠殑鎵€鏈夋秷鎭被鍨?*/
function onlineHandleMessage(msg) {
  switch (msg.type) {
    case 'room_created':
      roomCode = msg.room;
      myColor = BLACK;
      isHost = true;
      onlineStatusEl.textContent = '鎴块棿宸插垱寤猴細' + roomCode + '锛堜綘鎵ч粦鍏堣锛夛紝绛夊緟瀵规柟鍔犲叆鈥?;
      showInviteLink(buildInviteUrl(roomCode));   // 鐢熸垚骞舵樉绀轰竴閿個璇烽摼鎺?      onlineUpdateControls();
      updateStatus();
      break;
    case 'room_joined':
      roomCode = msg.room;
      myColor = WHITE;
      isHost = false;
      onlineReady = true;      // 鍔犲叆鍗冲紑灞€锛岀瓑榛戞鍏堟墜
      onlineStatusEl.textContent = '宸插姞鍏ユ埧闂?' + roomCode + '锛堜綘鎵х櫧锛?;
      inviteRow.style.display = 'none';   // 鍔犲叆鏂逛笉闇€瑕侀個璇烽摼鎺?      onlineUpdateControls();
      updateStatus();
      break;
    case 'peer_joined':
      onlineReady = true;      // 鎴夸富瑙嗚锛氬鏂瑰凡灏变綅锛屽灞€寮€濮?      onlineStatusEl.textContent = '瀵规柟宸插姞鍏ワ紝瀵瑰眬寮€濮嬶紒';
      inviteRow.style.display = 'none';   // 鎴块棿宸叉弧锛岄殣钘忛個璇烽摼鎺?      updateStatus();
      break;
    case 'move':
      onlineApplyRemoteMove(msg.r, msg.c);
      break;
    case 'reset':
      init(MODE_ONLINE);       // 鍙屾柟鍚屾閲嶅紑锛堜繚鐣欏湪绾胯繛鎺ヤ笌鎴块棿锛?      break;
    case 'peer_left':
      onlineReady = false;
      onlineStatusEl.textContent = '瀵规柟宸叉柇寮€杩炴帴锛屽灞€鏆傚仠';
      updateStatus();
      break;
    case 'game_over':
      // 瀹㈡埛绔湰鍦板凡鍒よ儨骞堕珮浜紝杩欓噷浠呰ˉ鍏呴潰鏉挎枃妗?      if (msg.winner) {
        const iWin = (msg.winner === 'black' && myColor === BLACK) || (msg.winner === 'white' && myColor === WHITE);
        onlineStatusEl.textContent = '瀵瑰眬缁撴潫锛? + (iWin ? '浣犺耽浜嗭紒' : '浣犺緭浜嗐€?);
      } else {
        onlineStatusEl.textContent = '瀵瑰眬缁撴潫锛氬钩灞€';
      }
      updateStatus();
      break;
    case 'error':
      onlineStatusEl.textContent = '閿欒锛? + msg.message;
      break;
    default:
      break;  // 鏈煡绫诲瀷蹇界暐锛屽悜鍓嶅吋瀹?  }
}

