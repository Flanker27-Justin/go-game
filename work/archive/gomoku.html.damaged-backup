  if (gameOver) {
    player = winLine ? (currentPlayer === playerColor ? 100 : 0) : 50;  // PvE 缁堝眬鏈崲鎵?  } else {
    // currentPlayer 鍦?updateStatus锛堟崲鎵嬪悗锛夎皟鐢ㄦ椂 = 鍗冲皢琛屽姩鏂癸紱
    // 浼犵粰 estimateWinRate 璁┾€滀竴姝ユ垚浜斺€濈殑 98% 閿佸畾鍙鐪熷疄琛屽姩鏂圭敓鏁?    player = estimateWinRate(currentPlayer).player;
  }
  const playerR = Math.round(player * 10) / 10;          // 缁熶竴鍥涜垗浜斿叆鍒?0.1锛?  const aiR = Math.round((100 - playerR) * 10) / 10;     // 閬垮厤鍑虹幇 31.700000000000003% 鐨勬诞鐐规畫宸?  winRateText.textContent = '浣?' + playerR + '% / AI ' + aiR + '%' + (gameOver && !winLine ? '锛堝钩灞€锛? : '');
  winRateBar.style.width = playerR + '%';
}

