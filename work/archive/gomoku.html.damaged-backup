<script>
'use strict';

/* ============================================================
 * 闆躲€佹墿灞曟帴鍙ｏ細娓告垙娉ㄥ唽琛紙GameAdapter锛? * ------------------------------------------------------------
 * 璁捐鐩爣锛氭妸鏈〉鍋氭垚鈥滄鏋?+ 娓告垙鈥濈殑鏋舵瀯鈥斺€斾簲瀛愭鏄涓€涓紙涔熸槸
 * 鐩墠鍞竴瀹屾暣鐨勶級娓告垙锛屽悗缁殑鍥介檯璞℃銆佸洿妫嬨€佷腑鍥借薄妫嬮€氳繃鍚屼竴濂? * 鎺ュ彛鎺ュ叆銆傛墍鏈夋父鎴忕粺涓€娉ㄥ唽杩?GAME_REGISTRY锛岀晫闈⑩€滄父鎴忊€濅笅鎷夋浼? * 鑷姩鍒楀嚭宸叉敞鍐岀殑娓告垙锛屾棤闇€鏀瑰姩妗嗘灦浠ｇ爜銆? *
 * 姣忎釜娓告垙瀹炵幇涓€涓€滈€傞厤鍣ㄥ璞♀€濓紙GameAdapter锛夛紝鏍稿績绾﹀畾濡備笅锛? *   id / name            蹇呭～銆傚敮涓€鏍囪瘑涓庣晫闈㈡樉绀哄悕
 *   modes                鏀寔鐨勬ā寮忔暟缁勶紝濡?['pvp', 'pve']
 *   boardSizes           鍙€夋牸鏁版暟缁勶紱null 琛ㄧず鍥哄畾妫嬬洏锛堝鍥介檯璞℃ 8脳8锛? *   defaultBoardSize     榛樿鏍兼暟锛堟湁 boardSizes 鏃跺缓璁粰鍑猴級
 *   aiLevels             AI 闅惧害琛紝濡?{ easy:'绠€鍗?, medium:'涓瓑' }锛沶ull 琛ㄧず鏆傛棤 AI
 *   defaultAiLevel       榛樿闅惧害锛堟湁 aiLevels 鏃跺缓璁粰鍑猴級
 *   supportsEdu          鏄惁鏀寔鏁欏鐐硅瘎锛堜汉鏈烘ā寮忎笅鎵嶆樉绀虹浉鍏冲紑鍏筹級
 *   onEnter()            鍒囧埌鏈父鎴忔椂璋冪敤锛氳礋璐ｅ垵濮嬪寲涓庨甯х粯鍒? *   onExit()             鍒囪蛋鏃惰皟鐢細璐熻矗娓呯悊瀹氭椂鍣ㄣ€佷复鏃剁洃鍚櫒绛? *   onCanvasClick(e)     鐢诲竷鐐瑰嚮浜嬩欢锛坋 涓哄師鐢熶簨浠跺璞★級
 *   onUndo()/onRestart() 鎮旀 / 閲嶆柊寮€濮嬶紙鏈疄鐜板彲鐪佺暐锛屾鏋朵細蹇界暐锛? *   onModeChange(mode)   鍙屼汉 / 浜烘満鍒囨崲
 *   onBoardSizeChange(n) 妫嬬洏鏍兼暟鍙樺寲
 *   onAiLevelChange(lv)  AI 闅惧害鍙樺寲
 *   onEduToggle(ok)      鏁欏鐐硅瘎寮€鍏筹紙鍙€夎兘鍔涳紝鏈疄鐜版椂蹇界暐鐐瑰嚮锛? *   onHintToggle(ok)     鎺ㄨ崘鐐瑰紑鍏筹紙鍙€夎兘鍔涳級
 *
 * 鎺ュ叆鏂版父鎴忎笁姝ワ細
 *   1) 澶嶅埗 games/_adapter-template.js 涓?games/浣犵殑娓告垙.js锛? *   2) 鎸夋枃浠堕噷鐨?TODO 閫愰」瀹炵幇閫傞厤鍣紱
 *   3) 鍦ㄩ〉闈㈡湯灏剧敤 <script src="games/浣犵殑娓告垙.js"> 鏍囩寮曞叆鏈枃浠跺嵆鍙? *      锛堟敞鎰忥細娉ㄩ噴閲屼笉瑕佸嚭鐜?script 鐨勭粨鏉熸爣绛惧瓧鏍凤紝鍚﹀垯浼氳 HTML
 *      瑙ｆ瀽鍣ㄥ綋浣滆剼鏈潡缁堢偣锛屽鑷村悗缁唬鐮佸叏閮ㄥけ鏁堬級銆? * 娉ㄥ唽鍚庢鏋惰嚜鍔ㄦ妸瀹冨姞鍏モ€滄父鎴忊€濅笅鎷夋锛屽苟鎸夊叾鑳藉姏鏄鹃殣璁剧疆椤广€? * ============================================================ */

/** 娓告垙娉ㄥ唽琛細id 鈫?閫傞厤鍣ㄥ璞°€傛墍鏈夋父鎴忛兘鐧昏鍦ㄨ繖閲?*/
const GAME_REGISTRY = {};

/** 褰撳墠婵€娲荤殑娓告垙 id锛堥粯璁?'gomoku'锛?*/
let activeGameId = null;

/** 娉ㄥ唽涓€涓父鎴忛€傞厤鍣紝骞跺埛鏂扳€滄父鎴忊€濅笅鎷夋 */
function registerGame(id, adapter) {
  GAME_REGISTRY[id] = adapter;
  refreshGameSelect();
}

/** 鑾峰彇褰撳墠婵€娲荤殑娓告垙閫傞厤鍣?*/
function getActiveGame() {
  return GAME_REGISTRY[activeGameId] || null;
}

/** 閲嶅缓鈥滄父鎴忊€濅笅鎷夋鐨勯€夐」锛屽敖閲忎繚鎸佸綋鍓嶉€夋嫨涓嶅彉 */
function refreshGameSelect() {
  const current = gameSelect.value || activeGameId || 'gomoku';
  gameSelect.innerHTML = '';
  for (const id of Object.keys(GAME_REGISTRY)) {
    const opt = document.createElement('option');
    opt.value = id;
    opt.textContent = GAME_REGISTRY[id].name;
    gameSelect.appendChild(opt);
  }
  if (GAME_REGISTRY[current]) gameSelect.value = current;
}

/** 鍒囨崲鍒版寚瀹氭父鎴忥細鍏堣鏃ф父鎴忔敹灏撅紝鍐嶈鏂版父鎴忔帴绠?*/
function switchGame(id) {
  const target = GAME_REGISTRY[id];
  if (!target) return;
  const old = getActiveGame();
  if (old && old.onExit) old.onExit();
  activeGameId = id;
  setFrameworkControlsEnabled(true);   // 鍏堟仮澶嶆帶浠讹紝鍙敤鎬т氦缁欐柊娓告垙鍐冲畾
  syncSettingsVisibility(target);      // 鎸夋柊娓告垙鑳藉姏鏄鹃殣/閲嶅缓璁剧疆椤?  if (target.onEnter) target.onEnter();
}

/**
 * 鎸夊綋鍓嶆父鎴忕殑澹版槑鑳藉姏锛屾樉闅愬苟閲嶅缓璁剧疆鍖烘帶浠讹細
 * - 妫嬬洏鏍兼暟锛氬彧鏈夊０鏄庝簡 boardSizes 鐨勬父鎴忔墠鏄剧ず锛? * - AI 闅惧害锛氫汉鏈烘ā寮忎笖澹版槑浜?aiLevels 鎵嶆樉绀猴紝閫夐」鐢辨父鎴忔彁渚涳紱
