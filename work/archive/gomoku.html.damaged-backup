      if (v < best) best = v;
      if (v < beta) beta = v;
      if (beta <= alpha) {                           // 鍓灊锛氬鏂硅繖鎵嬭宸辨柟鏃犳湜锛屽悓鏍峰姞鍒嗗苟璁板叆鏉€鎵嬭〃
        if (historyTable) historyTable[1][r * 19 + c] += depth * depth;
