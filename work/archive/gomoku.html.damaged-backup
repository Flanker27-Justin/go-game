      hashXor(r, c, me);
      const v = minimax(depth - 1, alpha, beta, false, me, opp);
      hashXor(r, c, me);
      board[r][c] = EMPTY;
      if (v > best) best = v;
      if (v > alpha) alpha = v;
      if (beta <= alpha) {                           // 鍓灊锛氳繖鎵嬭瘉鏄庢湁鏁堬紝鍘嗗彶鍔犲垎骞惰鍏ユ潃鎵嬭〃
        if (historyTable) historyTable[0][r * 19 + c] += depth * depth;
