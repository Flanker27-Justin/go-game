/**
 * 鐢熸垚鍊欓€夎惤鐐癸細鍙敹闆嗏€滃凡鏈夋瀛愬懆鍥?HINT_RADIUS 鏍煎唴鈥濈殑绌轰綅锛? * 鍐嶆寜鍚彂寮忓緱鍒嗛檷搴忓彇鍓?limit 涓€? * 鐞嗙敱锛氳繙绂绘瀛愮殑钀界偣鍦ㄥ紑灞€闃舵鍑犱箮鏃犳剰涔夛紝瑁佸壀鍙ぇ骞呯缉灏忔悳绱㈡爲銆? */
function getCandidateMoves(limit, color) {
  const seen = new Set();
  const list = [];
  const opp = color === BLACK ? WHITE : BLACK;

  for (let r = 0; r < boardSize; r++) {
    for (let c = 0; c < boardSize; c++) {
      if (board[r][c] === EMPTY) continue;
      for (let dr = -HINT_RADIUS; dr <= HINT_RADIUS; dr++) {
        for (let dc = -HINT_RADIUS; dc <= HINT_RADIUS; dc++) {
          const nr = r + dr, nc = c + dc;
          if (!inBoard(nr, nc) || board[nr][nc] !== EMPTY) continue;
          const key = nr * boardSize + nc;
          if (seen.has(key)) continue;
          seen.add(key);
          list.push([nr, nc]);
        }
      }
    }
  }

  const scored = list.map(([r, c]) => {
    // 寮哄埗璧版硶锛堣兘褰㈡垚鍐插洓/娲诲洓鐨勭偣锛夋帓鏈€鍓嶏細鎼滅储鍏堥獙璇佸叧閿偣锛屽壀鏋濇洿鏈夋晥
    const forcing = color ? threatLevel(r, c, color) * 8000 : 0;
    // 鍙屾潃鍊欓€夛紙涓€鎵嬪舰鎴愪袱涓椿涓変互涓婂▉鑳侊級鍐嶅姞鏉冿細浼樺厛鎺㈢储蹇呰儨璺嚎
    const doubleThreat = color && countThreats(r, c, color) >= 2 ? 16000 : 0;
    return { r, c, s: scoreFor(r, c, color, opp) + forcing + doubleThreat };
  });
  scored.sort((a, b) => b.s - a.s);   // 闄嶅簭锛氶珮鍒嗗€欓€夊湪鍓嶏紝鍓灊鏇存湁鏁?  return scored.slice(0, limit).map(({ r, c }) => [r, c]);
}

/**
 * 鍏ㄥ眬闈㈤潤鎬佽瘎浼帮細AI 鏂规€昏繘鏀诲垎 鈭?鐜╁鏂规€昏繘鏀诲垎 脳 1.1銆? * 鍏抽敭鏀硅繘锛氭瘡鏉¤繛绾垮彧浠庘€滆捣鐐光€濊涓€娆″垎锛岄伩鍏嶄竴鏉℃椿涓夎涓変釜瀛愰噸澶嶈 3 鍊嶏紝
 * 妫嬬洏瓒婃弧璇勪及瓒婂け鐪熴€傞槻瀹堟潈閲嶇暐楂橈紙1.1锛夛紝璁?AI 鏀婚槻鍙栬垗鏃剁◢寰亸淇濆畧銆? */
/**
 * 濞佽儊绌洪棿缁熻锛堝鏂瑰▉鑳佺┖闂寸殑璇勪及鍩虹锛夛細鍥寸粫 color 妫嬪瓙锛岀粺璁♀€滆惤瀛愬悗鑳? * 褰㈡垚娲讳笁浠ヤ笂濞佽儊鈥濈殑绌轰綅锛屽苟鎸夊▉鑳佺瓑绾у姞鏉冿紙娲讳笁 600 / 鍐插洓 2000 /
 * 娲诲洓 15000 / 鎴愪簲 80000锛夈€傚畠琛￠噺涓€鏂圭殑鈥滆繘鏀婚€夋嫨闈⑩€濃€斺€斿悓鏍蜂竴鏉℃椿涓夛紝
 * 鑳藉欢浼告垚娲诲洓鐨勯€夌偣澶氱殑涓€鏂规洿涓诲姩锛涘鏂瑰▉鑳佺┖闂磋秺澶э紝瓒婁笉鑳藉畨蹇冭繘鏀汇€? * 涓?comboBonus 鐨勫垎宸ワ細comboBonus 鍙鍔扁€滀竴鎵嬪弻濞佽儊鈥濈殑鏉€鎷涚偣锛岃繖閲屾妸
 * 鏅€氬崟绾垮▉鑳佷篃绠楄繘鏉ワ紝璁╁彾鑺傜偣璇勪及涓嶅啀鍙洴鐫€蹇呮潃鐐广€佹湁鍏ㄥ眬澶у眬瑙傘€? * 鏁伴噺涓婇檺 cap 鎺у埗璇勪及寮€閿€锛坢inimax 鍙惰妭鐐硅皟鐢ㄩ潪甯搁绻侊級銆? */
function threatSpaceBonus(color, cap = 48) {
  let bonus = 0;
  let checked = 0;
  const seen = new Set();
  for (let r = 0; r < boardSize; r++) {
    for (let c = 0; c < boardSize; c++) {
      if (board[r][c] !== color) continue;
      for (let dr = -1; dr <= 1; dr++) {
        for (let dc = -1; dc <= 1; dc++) {
          const nr = r + dr, nc = c + dc;
          if (!inBoard(nr, nc) || board[nr][nc] !== EMPTY) continue;
          const key = nr * boardSize + nc;
          if (seen.has(key)) continue;
