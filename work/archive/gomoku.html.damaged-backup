/**
 * 搴旂敤鐚滃厛缁撴灉銆? * @param {boolean|null} pickBlack true=璧㈠鎵ч粦 false=璧㈠鎵х櫧 null=浣跨敤 AI 鑷姩閫夋嫨鐨勭粨鏋? * 浜烘満妯″紡鍐?playerColor/aiColor锛涘弻浜烘ā寮忓啓 p1Color锛堢帺瀹? 鍙栫浉鍙嶉鑹诧級銆? */
function applyGuessPick(pickBlack) {
  if (!guessState) { closeGuessDialog(); return; }
  const winnerIsGuesser = guessState.winner === 'guesser';
  const winnerBlack = pickBlack === null ? guessState.winnerBlack : pickBlack;
  if (gameMode === MODE_PVE) {
    const playerIsBlack = winnerIsGuesser ? winnerBlack : !winnerBlack;
    playerColor = playerIsBlack ? BLACK : WHITE;
    aiColor = playerIsBlack ? WHITE : BLACK;
  } else {
    const p1IsBlack = winnerIsGuesser ? winnerBlack : !winnerBlack;
    p1Color = p1IsBlack ? BLACK : WHITE;
  }
  closeGuessDialog();
  updateStatus();
  // 鐜╁閫夋墽鐧?鈫?AI 鎵ч粦鍏堣锛屽厛璋冨害 AI 棣栨
  if (gameMode === MODE_PVE && currentPlayer === aiColor && !gameOver) {
    scheduleAiIfNeeded();
    draw();
    return;
  }
  // 鏁欒偛妯″紡涓嬫寜鏂扮殑鐜╁棰滆壊鍒锋柊鎺ㄨ崘鐐逛笌鍗遍櫓鐐归珮浜?  if (eduMode && gameMode === MODE_PVE && currentPlayer === playerColor && !gameOver) {
    refreshHint();
  } else {
    draw();
  }
}

/* ============================================================
 * 鍏€佽儨璐熷垽瀹? * 璇存槑锛氬彧妫€鏌モ€滃垰钀界殑瀛愨€濇槸鍚︽垚浜斺€斺€旇兘鎴愪簲鐨勮繛绾垮繀鐒剁┛杩囧畠銆? * ============================================================ */
/**
 * 妫€鏌ヤ互 (r, c) 涓烘渶鍚庝竴瀛愭槸鍚﹀舰鎴愪簲杩炪€? * @returns {Array|null} 鏁存潯杩炵嚎鐨勫潗鏍囨暟缁勶紙渚涢珮浜粯鍒讹級锛屾病鏈夊垯杩斿洖 null銆? */
function checkWin(r, c) {
  const color = board[r][c];

  for (const [dr, dc] of DIRECTIONS) {
    // 浠ヨ惤瀛愮偣涓轰腑蹇冿紝娌垮綋鍓嶆柟鍚戝悜涓ょ寤朵几锛屾敹闆嗗悓鑹叉瀛?    const line = [[r, c]];
    for (let i = 1; i < 5; i++) {
      const nr = r + dr * i, nc = c + dc * i;
      if (!inBoard(nr, nc) || board[nr][nc] !== color) break;
      line.push([nr, nc]);
    }
    for (let i = 1; i < 5; i++) {
      const nr = r - dr * i, nc = c - dc * i;
      if (!inBoard(nr, nc) || board[nr][nc] !== color) break;
      line.unshift([nr, nc]);
    }
    if (line.length >= 5) return line;
  }
  return null;
}

/* ============================================================
 * 涓冦€佺粯鍒讹紙鏁版嵁 鈫?鐢婚潰锛? * 璇存槑锛氭瘡娆″叏閲忛噸缁橈紝鍙 board 涓庡皯閲忕姸鎬侊紝淇濊瘉鐢婚潰涓庢暟鎹案杩滀竴鑷淬€? * ============================================================ */
