/* ============================================================
 * 涔澛蜂簲銆佸湪绾垮鎴橈紙WebSocket 鎴块棿锛? * 璇存槑锛氶€氳繃 WebSocket 涓庢湇鍔″櫒閫氫俊锛屽疄鐜扳€滅數鑴戝紑鎴裤€佹墜鏈鸿繘鎴库€濈殑
 * 鍙屼汉瀹炴椂瀵瑰紙銆傚崗璁负 JSON 娑堟伅锛屾湇鍔″櫒瑙?outputs/gomoku-server.js銆? * ------------------------------------------------------------
 * 娑堟伅涓€瑙堬細
 *   瀹㈡埛绔?鈫?鏈嶅姟鍣細create / join{room} / move{r,c} / reset
 *   鏈嶅姟鍣?鈫?瀹㈡埛绔細room_created / room_joined / peer_joined /
 *                   move / reset / peer_left / game_over / error
 * 鐘舵€佺害鏉燂細鍒涘缓鑰呮墽榛戝厛鎵嬶紝鍔犲叆鑰呮墽鐧斤紱鏈嶅姟鍣ㄦ牎楠屸€滄槸鍚﹁疆鍒拌嚜宸扁€濓紝
 * 瀹㈡埛绔篃鍋氬悓鏍风殑鎻愬墠鎷︽埅锛岄伩鍏嶆棤鏁堢偣鍑讳笌缃戠粶寰€杩斻€? * ============================================================ */

/** 寤虹珛 WebSocket 杩炴帴锛沘ction 涓?'create' 鎴?'join'锛宑ode 涓烘埧闂村彿 */
function onlineConnect(action, code) {
  if (ws && (ws.readyState === WebSocket.OPEN || ws.readyState === WebSocket.CONNECTING)) {
    onlineStatusEl.textContent = '宸茶繛鎺ワ紝璇峰嬁閲嶅鎿嶄綔';
    return;
  }
  let url = wsAddrInput.value.trim();
  if (!url) {
    // 鐣欑┖鏃惰嚜鍔ㄤ娇鐢ㄢ€滃綋鍓嶉〉闈㈠湴鍧€鈥濓紝濡?http://192.168.1.5:8123/ 鈫?ws://192.168.1.5:8123/ws
    url = (location.protocol === 'https:' ? 'wss://' : 'ws://') + location.host + '/ws';
  } else {
    if (!/^wss?:\/\//i.test(url)) url = 'ws://' + url;               // 娌″啓鍗忚灏辫ˉ ws://
    if (!/\/ws$/.test(url)) url = url.replace(/\/+$/, '') + '/ws';   // 娌″啓璺緞灏辫ˉ /ws
  }
  onlineStatusEl.textContent = '姝ｅ湪杩炴帴鏈嶅姟鍣ㄢ€?;
  try {
    ws = new WebSocket(url);
  } catch (err) {
    onlineStatusEl.textContent = '杩炴帴澶辫触锛? + err.message;
    return;
  }
  ws.onopen = () => {
    onlineStatusEl.textContent = action === 'create' ? '姝ｅ湪鍒涘缓鎴块棿鈥? : '姝ｅ湪鍔犲叆鎴块棿 ' + code + '鈥?;
    onlineSend({ type: action, room: code });
    onlineUpdateControls();
  };
  ws.onmessage = (evt) => {
    let msg;
    try { msg = JSON.parse(evt.data); } catch (err) { return; }  // 蹇界暐闈?JSON 娑堟伅
    onlineHandleMessage(msg);
  };
  ws.onclose = () => {
    onlineReady = false;
    myColor = null;
    isHost = false;
    roomCode = null;
    ws = null;
    onlineStatusEl.textContent = '杩炴帴宸叉柇寮€';
    inviteRow.style.display = 'none';
    onlineUpdateControls();
    updateStatus();
  };
  ws.onerror = () => { /* 鍑洪敊鍚庢祻瑙堝櫒浼氳嚜鍔ㄨЕ鍙?onclose锛岀粺涓€鍦ㄩ偅閲屾敹灏?*/ };
}

/** 鍙戦€?JSON 娑堟伅锛涙湭杩炴帴鎴栬繛鎺ヤ腑鍒欓潤榛樺拷鐣?*/
function onlineSend(obj) {
