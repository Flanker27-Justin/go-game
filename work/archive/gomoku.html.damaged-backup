  if (playerBest && playerBest.lv >= 3) return [playerBest.r, playerBest.c]; // 瀵规柟鎴愭椿鍥涳細蹇呴』鎸?  if (blockRushFours && playerBest && playerBest.lv === 2) return [playerBest.r, playerBest.c]; // 浠?VCF 闃插畧绛夊満鏅己鍒跺牭鍐插洓绔偣
  if (!skipOwnAttack && aiBest && aiBest.lv === 1) return [aiBest.r, aiBest.c]; // 鑷繁娲讳笁锛氫富鍔ㄨ繘鏀伙紝寤虹珛杩炴敾
