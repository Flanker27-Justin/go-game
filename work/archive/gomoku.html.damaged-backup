  drawStones();     // 鎵€鏈夋瀛?  drawLastMove();   // 鏈€鍚庝竴姝ユ爣璁帮紙灏忕孩鐐癸級
  drawWinLine();    // 鑾疯儨杩炵嚎楂樹寒锛堢孩绾匡級
  drawTeaching();   // 鏁欏妯″紡锛氱帺瀹舵鍨嬮珮浜?+ AI 鍗遍櫓鐐归棯鐑?  drawHint();       // 鏁欒偛妯″紡鎺ㄨ崘鐐癸紙鍗婇€忔槑鍦嗗湀锛?  updateTeachBlink(); // 鎸夐渶鍚姩/鍋滄鍗遍櫓鐐归棯鐑佸姩鐢?}

/** 缁樺埗鑳屾櫙銆佺綉鏍肩嚎涓庢槦浣嶏紱缃戞牸绾挎暟閲忋€佹槦浣嶅潗鏍囬兘闅忔鐩樻牸鏁拌嚜閫傚簲 */
function drawBoard() {
  ctx.fillStyle = '#e8c170';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  ctx.strokeStyle = '#5a3d1a';
  ctx.lineWidth = 1;

  // 缃戞牸锛氭í銆佺珫鍚?boardSize 鏉＄嚎
  const edge = MARGIN + (boardSize - 1) * CELL_SIZE;
  for (let i = 0; i < boardSize; i++) {
    const p = MARGIN + i * CELL_SIZE;
    ctx.beginPath();
    ctx.moveTo(p, MARGIN);
    ctx.lineTo(p, edge);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(MARGIN, p);
    ctx.lineTo(edge, p);
    ctx.stroke();
  }

  // 鏄熶綅锛氬ぉ鍏?+ 鍥涜鏄熴€傚叕寮忎繚璇?13/15/19 璺兘鑳借惤鍦ㄦ爣鍑嗕綅缃?  const center = (boardSize - 1) / 2;
  const starRows = [...new Set([3, center, boardSize - 4])];
  ctx.fillStyle = '#5a3d1a';
  for (const r of starRows) {
    for (const c of starRows) {
      ctx.beginPath();
      ctx.arc(boardX(c), boardY(r), 4, 0, Math.PI * 2);
      ctx.fill();
    }
  }
}

/** 缁樺埗鍏ㄩ儴妫嬪瓙锛氶粦瀛愭繁鑹插疄蹇冿紝鐧藉瓙娴呰壊甯︽弿杈?*/
function drawStones() {
  for (let r = 0; r < boardSize; r++) {
    for (let c = 0; c < boardSize; c++) {
      if (board[r][c] === EMPTY) continue;
      const isBlack = board[r][c] === BLACK;
      ctx.beginPath();
      ctx.arc(boardX(c), boardY(r), CELL_SIZE * 0.42, 0, Math.PI * 2);
      ctx.fillStyle = isBlack ? '#111' : '#f5f5f5';
      ctx.fill();
      ctx.strokeStyle = isBlack ? '#000' : '#999';
      ctx.lineWidth = 1;
      ctx.stroke();
    }
  }
}

/** 鍦ㄦ渶鍚庝竴姝ユ瀛愪笂鐢诲皬绾㈢偣锛屾柟渚垮灞€鏃惰拷韪灞€璧板悜 */
function drawLastMove() {
  if (!lastMove) return;
  const [r, c] = lastMove;
  ctx.beginPath();
  ctx.arc(boardX(c), boardY(r), 5, 0, Math.PI * 2);
  ctx.fillStyle = '#e74c3c';
  ctx.fill();
}

/** 鐢ㄧ孩绾胯繛鎺ヨ幏鑳滀簲瀛愶紝缁撴灉涓€鐩簡鐒?*/
function drawWinLine() {
  if (!winLine) return;
  ctx.strokeStyle = '#e74c3c';
  ctx.lineWidth = 3;
  ctx.beginPath();
  winLine.forEach(([r, c], i) => {
    const x = boardX(c), y = boardY(r);
    if (i === 0) ctx.moveTo(x, y);
    else ctx.lineTo(x, y);
  });
  ctx.stroke();
}

/** 鏁欒偛妯″紡锛氬湪 AI 鎺ㄨ崘鐨勮惤鐐圭敾鍗婇€忔槑缁胯壊鏍囪锛堜粎杞埌鐜╁鏃舵樉绀猴級 */
