/** 鏁欏妯″紡缁樺埗灞傦細楂樹寒鐜╁鏈€鍚庝竴姝ョ殑妫嬪瀷绾匡紝骞堕棯鐑?AI 涓嬩竴姝ュ彲鎴愪簲鐨勫嵄闄╃偣 */
function drawTeaching() {
  if (!eduMode || gameMode !== MODE_PVE || gameOver) return;
  // 鈶?鐜╁鏈€鍚庝竴姝ュ舰鎴愮殑妫嬪瀷鏂瑰悜锛氶粍鑹插崐閫忔槑绮楃嚎锛堢敾鍦ㄦ瀛愪箣涓婏紝
  //    鐩磋灞曠ず鈥滆繖姝ュ舰鎴愪簡娲讳笁/鍐插洓鈥濈瓑妫嬪瀷璧板悜锛?  if (lastMove && board[lastMove[0]][lastMove[1]] === playerColor) {
    const [r, c] = lastMove;
    const p = analyzePoint(r, c, playerColor);
    if (p.count >= 2) {
      const cells = [];
      let rr = r, cc = c;
      while (inBoard(rr, cc) && board[rr][cc] === playerColor) { cells.push([rr, cc]); rr -= p.dr; cc -= p.dc; }
      cells.reverse();
      rr = r + p.dr; cc = c + p.dc;
      while (inBoard(rr, cc) && board[rr][cc] === playerColor) { cells.push([rr, cc]); rr += p.dr; cc += p.dc; }
      if (cells.length >= 2) {
        ctx.beginPath();
        ctx.moveTo(boardX(cells[0][1]), boardY(cells[0][0]));
        for (let i = 1; i < cells.length; i++) ctx.lineTo(boardX(cells[i][1]), boardY(cells[i][0]));
        ctx.strokeStyle = 'rgba(240, 200, 60, 0.35)';
        ctx.lineWidth = CELL_SIZE * 0.62;
        ctx.lineCap = 'round';
        ctx.stroke();
      }
    }
  }
  // 鈶?AI 涓嬩竴姝ュ彲鎴愪簲鐨勫嵄闄╃偣锛氱孩鑹插渾鍦堬紝闅?300ms 鑺傚闂儊锛屾彁閱掔帺瀹跺厛闃插畧
  if (currentPlayer === playerColor) {
    const danger = findImmediateWin(aiColor);
    if (danger) {
      const on = Math.floor(Date.now() / 300) % 2 === 0;
      if (on) {
        ctx.beginPath();
        ctx.arc(boardX(danger[1]), boardY(danger[0]), CELL_SIZE * 0.45, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(220, 60, 50, 0.9)';
        ctx.lineWidth = 3;
        ctx.stroke();
      }
    }
  }
}

/** 鍗遍櫓鐐归棯鐑侊細瀛樺湪鈥淎I 涓嬩竴姝ュ彲鎴愪簲鈥濇椂鍚姩 300ms 閲嶇粯瀹氭椂鍣紝鍚﹀垯鍋滄 */
function updateTeachBlink() {
  const active = eduMode && gameMode === MODE_PVE && !gameOver &&
                 currentPlayer === playerColor && !!findImmediateWin(aiColor);
  if (active && !teachBlinkTimer) {
    teachBlinkTimer = setInterval(() => {
      if (eduMode && gameMode === MODE_PVE && !gameOver && currentPlayer === playerColor && findImmediateWin(aiColor)) {
        draw();
      } else {
        clearInterval(teachBlinkTimer);
        teachBlinkTimer = null;
      }
    }, 300);
  } else if (!active && teachBlinkTimer) {
    clearInterval(teachBlinkTimer);
    teachBlinkTimer = null;
  }
}

