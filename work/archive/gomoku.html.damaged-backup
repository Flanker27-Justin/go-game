    const info = lineInfo(r, c, dr, dc, color);
    let lv = 0;
    if (info.count >= 5) lv = 4;                        // 鐩存帴鎴愪簲
    else if (info.count === 4 && info.open === 2) lv = 3;  // 娲诲洓锛氫袱绔兘寮€锛屾棤瑙?    else if (info.count === 4 && info.open === 1) lv = 2;  // 鍐插洓锛氬崟绔紑锛岄€煎鏂瑰簲鎵?    else if (info.count === 3 && info.open === 2) lv = 1;  // 娲讳笁锛氳兘鍙戝睍鎴愭椿鍥?    if (lv > best) best = lv;
  }
  return best;
}

/**
 * 涓€姝ュ繀鏉€妫€娴嬶細鑻ュ湪 (r, c) 鏀?color 鑳界珛鍒绘垚浜斿垯杩斿洖璇ョ偣銆? * 鐢?canWinNow 鐩存帴鏁拌繛瀛愶紝涓嶄慨鏀规鐩橈紝閫熷害姣斺€滀复鏃惰惤瀛愬啀鍒よ儨鈥濆揩寰楀銆? */
function findImmediateWin(color) {
  for (let r = 0; r < boardSize; r++) {
    for (let c = 0; c < boardSize; c++) {
      if (board[r][c] !== EMPTY) continue;
      if (canWinNow(r, c, color)) return [r, c];
    }
  }
  return null;
}

/** 蹇€熷垽鏂細鎶?color 鏀惧湪 (r, c) 鍚庢槸鍚﹀舰鎴愪簲杩烇紙涓嶄慨鏀规鐩橈級 */
function canWinNow(r, c, color) {
  for (const [dr, dc] of DIRECTIONS) {
    let count = 1;
    for (const dir of [1, -1]) {
      for (let i = 1; i < 5; i++) {
        const nr = r + dr * i * dir;
        const nc = c + dc * i * dir;
        if (!inBoard(nr, nc) || board[nr][nc] !== color) break;
        count++;
      }
    }
    if (count >= 5) return true;
  }
  return false;
}

