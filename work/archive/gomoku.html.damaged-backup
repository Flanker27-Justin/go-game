  }
  return bonus;
}

/**
 * 灞€闈㈣瘎浼帮細宸辨柟鍏ㄩ儴妫嬪瀷鍒?鈭?瀵规柟鍏ㄩ儴妫嬪瀷鍒喢?.1锛屽彟鍔犺繛鎺ユ€с€佷腑蹇冩潈閲嶃€? * 鍙屽▉鑳佺粍鍚堝垎涓庘€滃▉鑳佺┖闂粹€濆垎锛堣 threatSpaceBonus锛夈€? * @param {number} [comboWeight] 鍙屽▉鑳?濞佽儊绌洪棿鍒嗙殑鎶樻墸绯绘暟锛欰I 鍐崇瓥鐢?1锛? *        鑳滅巼浼扮畻浼?0.25锛岄伩鍏嶁€滃弻涓?娲讳笁寤朵几鈥濊繖绫诲己鑰屼笉蹇呰儨鐨勬鍨嬫妸鑳滅巼鎺ㄨ繃澶? */
function evaluateBoard(me = aiColor, opp = playerColor, comboWeight = 1, tempoFor = null) {
  let aiScore = 0;
