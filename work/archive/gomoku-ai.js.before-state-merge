/** 撤销落子并维护全部增量结构（与 enterMove 严格对称） */
function leaveMove(r, c, color) {
  board[r][c] = EMPTY;
  hashXor(r, c, color);
  pieceCount--;
  touchNear2(r, c, -1);
  refreshEvalAt(r, c);
}

/** 整盘重建增量结构（初始化、换棋盘、检测到外部直接改写棋盘时调用） */
