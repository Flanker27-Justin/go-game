/* ============================================================
 * 九·七、胜率预测（人机对战）
 * 说明：用当前局面的静态评估分数估算 AI/玩家胜率，并以色条可视化。
 * 算法：先把棋盘评估分（evaluateBoard，AI 视角正分=AI 优）过 tanh 映射到
 * 0~1，再缩放成百分比。三个防“假胜率”的措施：
 *  1) 98% 封顶只给“轮到的一方”的一步成五（对方马上会挡的冲四不算锁定胜局）；
 *  2) 双威胁组合分（双三候选）在胜率里打 2.5 折，强但不必胜的棋型只到 60~80%；
 *  3) 映射标尺加大，普通优势不再被 tanh 放大成 90%+。
 * ============================================================ */

/**
 * 估算当前局面的胜率（纯棋盘函数，便于测试）。
 * @param {number|null} nextPlayer 即将行动的一方（BLACK/WHITE）；null=不区分回合
 *   （测试用）。只有“轮到的一方”能一步成五时才锁定 98%——因为对方下一步
 *   可以先挡，冲四这类棋型并不等于已经赢了。
 * @returns {{player: number, ai: number}} 玩家/AI 胜率百分比（0~100）
 */
function estimateWinRate(nextPlayer) {
  // 规则修正：轮到谁、谁能下一步成五，谁几乎锁定胜局
  const aiWin = findImmediateWin(aiColor);
  const plWin = findImmediateWin(playerColor);
  if (aiWin && (nextPlayer == null || nextPlayer === aiColor)) return { player: 2, ai: 98 };
  if (plWin && (nextPlayer == null || nextPlayer === playerColor)) return { player: 98, ai: 2 };
  // 静态评估 → tanh 映射；双威胁组合分打折，避免“双三”等棋型误报成 98%
  const score = evaluateBoard(aiColor, playerColor, WIN_RATE_COMBO_WEIGHT);
  const ai = Math.max(2, Math.min(98, 50 + 50 * Math.tanh(score / WIN_RATE_SCALE)));
  const aiR = Math.round(ai * 10) / 10;
  return { player: Math.round((100 - aiR) * 10) / 10, ai: aiR };
}

/** 刷新胜率面板：仅人机模式且开关开启时显示；终局直接显示 100/0 或 0/100 */
function updateWinRate() {
  if (gameMode !== MODE_PVE || !showWinRate) {
    winRatePanel.style.display = 'none';
    return;
  }
  winRatePanel.style.display = '';
  let player;
  if (gameOver) {
    player = winLine ? (currentPlayer === playerColor ? 100 : 0) : 50;  // PvE 终局未换手
  } else {
    // currentPlayer 在 updateStatus（换手后）调用时 = 即将行动方；
    // 传给 estimateWinRate 让“一步成五”的 98% 锁定只对真实行动方生效
    player = estimateWinRate(currentPlayer).player;
  }
  const playerR = Math.round(player * 10) / 10;          // 统一四舍五入到 0.1，
  const aiR = Math.round((100 - playerR) * 10) / 10;     // 避免出现 31.700000000000003% 的浮点残差
  winRateText.textContent = '你 ' + playerR + '% / AI ' + aiR + '%' + (gameOver && !winLine ? '（平局）' : '');
  winRateBar.style.width = playerR + '%';
}

