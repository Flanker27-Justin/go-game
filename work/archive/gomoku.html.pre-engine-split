<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>五子棋</title>
<style>
  /* ============================================================
   * 页面基础样式：整体居中、米黄底色，模拟传统棋盘纸的质感
   * ============================================================ */
  body {
    font-family: "Microsoft YaHei", sans-serif;
    text-align: center;
    background: #f2ead9;
    margin: 0;
    padding: 20px;
  }
  h1 { margin: 0 0 8px; }

  /* ===== 状态栏与工具按钮 ===== */
  #status { font-size: 20px; margin-bottom: 10px; }
  #toolbar { margin-bottom: 10px; }
  button {
    margin: 0 4px;
    padding: 6px 16px;
    font-size: 14px;
    border: 1px solid #a67c2e;
    border-radius: 6px;
    background: #fff;
    color: #5a3d1a;
    cursor: pointer;
  }
  button:hover { background: #f0e6d0; }
  button.active {               /* 当前选中的模式按钮 */
    background: #4a7c59;
    border-color: #4a7c59;
    color: #fff;
  }

  /* ===== 设置区：棋盘格数 / AI 难度 / 教学开关 ===== */
  #settings {
    margin: 10px 0;
    display: flex;
    gap: 16px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }
  #settings label { font-size: 14px; color: #5a3d1a; }
  #settings select {
    padding: 4px 6px;
    border: 1px solid #a67c2e;
    border-radius: 4px;
    background: #fff;
    color: #5a3d1a;
  }
  #settings input[type="checkbox"] { vertical-align: -2px; }
  /* 双人模式下 AI 相关控件禁用置灰 */
  #settings select:disabled,
  #settings input:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  /* ===== 教学点评面板：显示 AI 对玩家落子的评价和 AI 的思路 ===== */
  #commentPanel {
    min-height: 52px;
    width: min(760px, 92vw);
    margin: 10px auto 10px;
    padding: 8px 12px;
    text-align: left;
    background: #fffdf5;
    border: 1px dashed #a67c2e;
    border-radius: 8px;
    font-size: 14px;
    color: #5a3d1a;
    box-sizing: border-box;
  }
  .comment-row { margin: 3px 0; }
  .tag { display: inline-block; min-width: 72px; font-weight: bold; }

  /* ===== 在线对战面板：房间号输入 / 创建 / 加入 ===== */
  #onlinePanel {
    margin: 10px auto;
    width: min(760px, 92vw);
    padding: 8px 12px;
    text-align: left;
    background: #fffdf5;
    border: 1px dashed #a67c2e;
    border-radius: 8px;
    font-size: 14px;
    color: #5a3d1a;
    box-sizing: border-box;
  }
  .online-row {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }
  #onlinePanel input {
    padding: 4px 6px;
    border: 1px solid #a67c2e;
    border-radius: 4px;
    font-size: 14px;
  }
  #onlinePanel button { margin: 0; }
  #onlineHint { color: #8a6d3b; font-size: 13px; }
  #onlineStatus { font-weight: bold; }
  #onlinePlayers { display: flex; gap: 8px; margin: 6px 0; }
  .player-card {
    flex: 1; display: flex; align-items: center; gap: 6px;
    padding: 3px 8px; border: 1px solid #ccc; border-radius: 8px;
    background: #fafafa; opacity: 0.72;
  }
  .player-card.active {
    background: #fffbe6; border-color: #f0b429; opacity: 1;
    box-shadow: 0 0 6px rgba(240, 180, 41, 0.35);
  }
  .player-dot { width: 14px; height: 14px; border-radius: 50%; border: 1px solid #999; flex: none; }
  .player-dot.black { background: #222; }
  .player-dot.white { background: #fff; }
  .player-info { flex: 1; min-width: 0; }
  .player-name { font-weight: bold; font-size: 12px; }
  .player-sub { font-size: 11px; color: #666; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .player-turn { font-size: 11px; font-weight: bold; color: #b8860b; flex: none; }
  /* 聊天开关行：默认收起聊天，不挤占棋盘空间 */
  .chat-toggle-row { display: flex; align-items: center; gap: 6px; margin: 4px 0; }
  .chat-toggle-row button { margin: 0; }
  .chat-toggle-row.hot button { background: #fdebb3; border-color: #f0b429; }
  #chatBadge {
    min-width: 18px; height: 18px; line-height: 18px; border-radius: 9px;
    background: #e5484d; color: #fff; font-size: 11px; font-weight: bold;
    text-align: center; padding: 0 5px; display: inline-block;
  }
  /* 聊天快捷语：表情/常用语一键发送 */
  .chat-quick-row { display: flex; flex-wrap: wrap; gap: 4px; padding: 4px 6px; border-top: 1px solid #eee; }
  .chat-quick-row button.quick {
    padding: 2px 8px; font-size: 13px; margin: 0;
    background: #faf6ec; border: 1px solid #ddd; border-radius: 12px; cursor: pointer;
  }
  .chat-quick-row button.quick:hover { background: #fdebb3; border-color: #f0b429; }
  /* 聊天消息气泡化：自己靠右（棕色底）、对方靠左（浅灰底） */
  #chatLog { display: flex; flex-direction: column; gap: 5px; }
  .chat-msg { max-width: 78%; word-break: break-word; align-self: flex-start; }
  .chat-msg .bubble {
    display: inline-block; padding: 5px 9px; border-radius: 10px;
    background: #f1f1f1; border: 1px solid #e3e3e3; font-size: 13px; color: #333;
  }
  .chat-msg.mine { align-self: flex-end; }
  .chat-msg.mine .bubble { background: #fff3d6; border-color: #e8cf9a; }
  .chat-msg .meta { font-size: 11px; color: #999; margin: 1px 4px; }
  .chat-msg.mine .meta { text-align: right; }
  .chat-msg .who { font-weight: bold; margin-right: 4px; color: #5a3d1a; }
  .chat-msg.mine .who { color: #a5711f; }
  /* 通话区：来电横幅与通话中的音视频 */
  #incomingCall {
    display: flex; align-items: center; gap: 8px; padding: 6px 10px; margin: 4px 0;
    background: #fff8e6; border: 1px solid #f0b429; border-radius: 8px; font-size: 14px;
  }
  #incomingCall button { margin: 0; }
  #incomingCall button#btnAcceptCall { background: #2f9e44; color: #fff; }
  #incomingCall button#btnRejectCall { background: #e5484d; color: #fff; }
  #callArea {
    border: 1px solid #ddd; border-radius: 8px; background: #fafafa; margin: 4px 0; padding: 6px;
  }
  #callVideos { display: flex; gap: 6px; justify-content: center; }
  #callVideos video {
    width: 46%; max-width: 240px; background: #111; border-radius: 6px;
    object-fit: contain; aspect-ratio: 4 / 3; background: #000;
  }
  #callVideos video#localVideo { width: 34%; max-width: 150px; }
  .call-controls { display: flex; gap: 6px; justify-content: center; margin-top: 6px; }
  .call-controls button { margin: 0; }
  #callStatus { color: #8a6d3b; font-size: 13px; }
  #onlineActions button { margin: 0; }
  #onlineActions button#btnCallAudio { background: #fffbe6; }
  #onlineActions button#btnCallVideo { background: #fffbe6; }
  #onlineActions button#btnHangupCall { background: #e5484d; color: #fff; }
  /* 邀请区在对局中保留：收起二维码后不占高度，展开时提示高亮 */
  #inviteRow .btn-toggle-qr-on { background: #fdebb3; border-color: #f0b429; }
  #inviteRow.flash { outline: 2px dashed #f0b429; outline-offset: 2px; border-radius: 6px; }
  #chatPanel {
    border: 1px solid #ddd; border-radius: 8px; background: #fff;
    margin: 6px 0; display: flex; flex-direction: column; max-height: 200px;
  }
  #chatLog { flex: 1; overflow-y: auto; min-height: 90px; max-height: 140px; padding: 6px 8px; font-size: 13px; }
  .chat-input-row { display: flex; gap: 4px; border-top: 1px solid #eee; padding: 4px; }
  .chat-input-row input { flex: 1; min-width: 0; }
  #roomCodeBig {
    font-size: 26px;
    font-weight: bold;
    color: #5a3d1a;
    letter-spacing: 4px;
    text-align: center;
    padding: 4px 0;
  }
  #qrWrap { text-align: center; margin: 4px 0; }
  #qrCanvas {
    display: block;
    margin: 4px auto;
    border: 1px solid #a67c2e;
    background: #fff;
  }
  #qrHint { color: #8a6d3b; font-size: 12px; }
  #onlinePanel input:disabled,
  #onlinePanel button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  /* ===== 邀请链接行（建房后显示）===== */
  #inviteRow input[readonly] {
    background: #f6f0dd;
    cursor: text;
    width: min(340px, 60vw);
  }

  /* ===== 猜先弹窗：抛硬币 / 猜奇偶 ===== */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }
  .modal-card {
    width: min(430px, 92vw);
    background: #fffdf5;
    border: 2px solid #a67c2e;
    border-radius: 12px;
    padding: 16px 20px;
    text-align: center;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3);
  }
  .modal-card h3 { margin: 0 0 6px; color: #5a3d1a; }
  .modal-card p { margin: 8px 0; color: #5a3d1a; font-size: 14px; }
  .guess-tabs { display: flex; justify-content: center; gap: 10px; margin: 10px 0; }
  .guess-tabs button.active { background: #4a7c59; border-color: #4a7c59; color: #fff; }
  .guess-body {
    min-height: 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .guess-result { font-size: 16px; font-weight: bold; color: #4a7c59; min-height: 24px; }
  .guess-pick { margin-top: 6px; }
  .guess-foot { margin-top: 12px; }

  /* ===== 胜率面板：人机对战胜率条可视化 ===== */
  #winRatePanel {
    margin: 0 auto 10px;
    width: min(760px, 92vw);
    padding: 8px 12px;
    text-align: left;
    background: #fffdf5;
    border: 1px dashed #a67c2e;
    border-radius: 8px;
    font-size: 14px;
    color: #5a3d1a;
    box-sizing: border-box;
  }
  #winRateTrack {
    height: 14px;
    border-radius: 7px;
    background: #c2543e;                 /* 底色=AI 红，右侧剩余部分为 AI 份额 */
    overflow: hidden;
    position: relative;
  }
  #winRateTrack::after {                 /* 50% 中线：一眼看出谁占优 */
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(255, 255, 255, 0.85);
    z-index: 1;
  }
  #winRateBar {
    height: 100%;
    background: linear-gradient(90deg, #3f7a4f, #7fae6f);   /* 玩家绿：从左向右铺开 */
    border-radius: 7px 0 0 7px;
    transition: width 0.3s ease;
  }

  /* ===== 棋盘画布 ===== */
  #board {
    background: #e8c170;
    cursor: pointer;
    border: 1px solid #a67c2e;
  }
</style>
</head>
<body>
  <h1>五子棋</h1>
  <div id="status">黑棋回合</div>
  <div id="toolbar">
    <button id="btnPvp" class="active">双人对战</button>
    <button id="btnPve">人机对战</button>
    <button id="btnOnline">在线对战</button>
    <button id="btnUndo">悔棋</button>
    <button id="btnRestart">重新开始</button>
  </div>
  <div id="settings">
    <label id="gameLabel">游戏
      <select id="gameSelect"></select>
    </label>
    <label id="boardSizeLabel">棋盘
      <select id="boardSizeSelect">
        <option value="13">13×13</option>
        <option value="15">15×15</option>
        <option value="19" selected>19×19</option>
      </select>
    </label>
    <label id="aiLevelLabel">AI 难度
      <select id="aiLevelSelect">
        <option value="easy">简单</option>
        <option value="medium" selected>中等</option>
        <option value="hard">困难</option>
      </select>
    </label>
    <label id="eduLabel"><input type="checkbox" id="eduModeToggle"> 教学点评</label>
    <label id="hintLabel"><input type="checkbox" id="showHintToggle" checked> 推荐点</label>
    <label id="guessLabel"><input type="checkbox" id="guessFirstToggle" checked> 开局猜先</label>
    <label id="winRateLabel"><input type="checkbox" id="winRateToggle" checked> 胜率显示</label>
  </div>
  <div id="onlinePanel" style="display:none">
    <div class="online-row">
      <label>服务器 <input id="wsAddrInput" placeholder="留空=当前页面地址" size="28"></label>
      <label>房间号 <input id="roomCodeInput" maxlength="5" size="7" placeholder="如 AB12C"></label>
      <button id="btnCreateRoom">创建房间</button>
      <button id="btnJoinRoom">加入房间</button>
      <button id="btnLeaveRoom" disabled>断开</button>
    </div>
    <div class="online-row" id="inviteRow" style="display:none">
      <label>邀请链接 <input id="inviteLinkInput" readonly size="34"></label>
      <button id="btnCopyInvite">复制链接</button>
      <button id="btnShareInvite">分享（微信）</button>
      <button id="btnToggleQr">扫码入局</button>
    </div>
    <div class="online-row" id="rematchRow" style="display:none">
      <button id="btnRematch" disabled>再来一局</button>
      <span id="rematchHint" style="color:#8a6d3b;font-size:13px">对局结束后任一方点击，双方同步重开一局</span>
    </div>
    <div id="roomCodeBig" style="display:none"></div>
    <div id="qrWrap" style="display:none">
      <canvas id="qrCanvas" width="176" height="176"></canvas>
      <div id="qrHint">用手机相机 / 微信扫一扫即可入局</div>
    </div>
    <div id="onlinePlayers">
      <div class="player-card" id="myPlayerCard">
        <span class="player-dot" id="myPlayerDot"></span>
        <div class="player-info">
          <div class="player-name" id="myPlayerName">你</div>
          <div class="player-sub" id="myPlayerSub">未加入房间</div>
        </div>
        <div class="player-turn" id="myPlayerTurn"></div>
      </div>
      <div class="player-card" id="peerPlayerCard">
        <span class="player-dot" id="peerPlayerDot"></span>
        <div class="player-info">
          <div class="player-name" id="peerPlayerName">对方</div>
          <div class="player-sub" id="peerPlayerSub">等待加入…</div>
        </div>
        <div class="player-turn" id="peerPlayerTurn"></div>
      </div>
    </div>
    <div class="online-row" id="onlineActions" style="display:none">
      <label>昵称 <input id="nicknameInput" maxlength="12" size="10" placeholder="点这里改昵称" autocomplete="off"></label>
      <button id="btnCallAudio" title="与对方实时语音通话（需要 HTTPS 访问）">📞 语音</button>
      <button id="btnCallVideo" title="与对方实时视频通话（需要 HTTPS 访问）">📹 视频</button>
      <button id="btnHangupCall" style="display:none">挂断</button>
      <span id="callStatus"></span>
    </div>
    <div id="incomingCall" style="display:none">
      <span id="incomingText">对方请求语音通话…</span>
      <button id="btnAcceptCall">接听</button>
      <button id="btnRejectCall">拒绝</button>
    </div>
    <div id="callArea" style="display:none">
      <div id="callVideos">
        <video id="remoteVideo" autoplay playsinline></video>
        <video id="localVideo" autoplay playsinline muted></video>
      </div>
      <div class="call-controls">
        <button id="btnMuteAudio">🎙 静音</button>
        <button id="btnToggleCamera">📷 关摄像头</button>
        <button id="btnHangupCall2">挂断</button>
      </div>
    </div>
    <div class="chat-toggle-row" id="chatToggleRow">
      <button id="btnChatToggle">💬 聊天</button>
      <span id="chatBadge" style="display:none">0</span>
      <span id="chatToggleHint" style="color:#8a6d3b;font-size:12px">双方实时交流，入局后可用</span>
    </div>
    <div id="chatWrap" style="display:none">
      <div id="chatPanel">
        <div id="chatLog"></div>
        <div class="chat-quick-row" id="chatQuickRow">
          <button class="quick" data-quick="😄">😄</button>
          <button class="quick" data-quick="👍">👍</button>
          <button class="quick" data-quick="😂">😂</button>
          <button class="quick" data-quick="😮">😮</button>
          <button class="quick" data-quick="🎉">🎉</button>
          <button class="quick" data-quick="该你了">该你了</button>
          <button class="quick" data-quick="好棋！">好棋！</button>
          <button class="quick" data-quick="让我想想…">让我想想…</button>
          <button class="quick" data-quick="再来一局？">再来一局？</button>
          <button class="quick" data-quick="哈哈">哈哈</button>
        </div>
        <div class="chat-input-row">
          <input id="chatInput" maxlength="200" placeholder="输入消息，回车发送" autocomplete="off">
          <button id="btnChatSend">发送</button>
        </div>
      </div>
    </div>
    <div id="onlineStatus"></div>
    <div id="onlineHint">① 选好棋盘格数 → ② 创建房间 → ③ 用【复制链接】或【扫码】邀请对方 → ④ 入局后用【聊天】实时交流、用【📞/📹】语音视频通话。对方打开链接（微信/QQ 均可）会自动进房；对方离开后房间保留，把链接再发一次即可重新加入；异地朋友请用 cpolar 公网地址访问。</div>
  </div>
  <div id="commentPanel">
    <div class="comment-row"><span class="tag">💬 点评</span><span id="playerComment">教学点评开启后，AI 会点评你的每一步。</span></div>
    <div class="comment-row"><span class="tag">🤖 AI 思路</span><span id="aiComment"></span></div>
  </div>
  <div id="winRatePanel">
    <div class="comment-row"><span class="tag">📊 胜率</span><span id="winRateText">—</span></div>
    <div id="winRateTrack"><div id="winRateBar"></div></div>
  </div>
  <div id="guessModal" class="modal-overlay" style="display:none">
    <div class="modal-card">
      <h3>🎲 猜先 · 决定谁执黑</h3>
      <p id="guessIntro"></p>
      <div class="guess-tabs">
        <button id="guessTabCoin" class="active">🎲 抛硬币</button>
        <button id="guessTabStones">🎲 猜奇偶</button>
      </div>
      <div id="guessBodyCoin" class="guess-body">
        <button id="btnFlipCoin">掷硬币</button>
        <div id="coinResult" class="guess-result"></div>
      </div>
      <div id="guessBodyStones" class="guess-body" style="display:none">
        <p>系统已悄悄抓了一把棋子（1~5 颗），猜猜是奇数还是偶数？</p>
        <div>
          <button id="btnGuessOdd">奇数</button>
          <button id="btnGuessEven">偶数</button>
        </div>
        <div id="stoneResult" class="guess-result"></div>
      </div>
      <div id="guessPick" class="guess-pick" style="display:none">
        <p id="guessPickText"></p>
        <button id="btnPickBlack">执黑（先手）</button>
        <button id="btnPickWhite">执白</button>
        <button id="btnGuessStart" style="display:none">开始对局</button>
      </div>
      <div class="guess-foot">
        <button id="btnGuessSkip">跳过（默认黑方先手）</button>
      </div>
    </div>
  </div>

  <!-- 联机猜先弹窗：服务器权威掷硬币，公平决定谁执黑（避免谁先连谁占优） -->
  <div id="onlineGuessModal" class="modal-overlay" style="display:none">
    <div class="modal-card">
      <h3>🎲 联机猜先 · 公平决定谁执黑</h3>
      <p id="ogIntro"></p>
      <div id="ogCoinPick" style="display:none">
        <p>请选择你猜的硬币面（只能选一次）：</p>
        <div>
          <button id="ogBtnHeads">正面</button>
          <button id="ogBtnTails">反面</button>
        </div>
      </div>
      <div id="ogResult" class="guess-result"></div>
      <div id="ogColorPick" class="guess-pick" style="display:none">
        <p id="ogColorPickText"></p>
        <button id="ogBtnBlack">执黑（先手）</button>
        <button id="ogBtnWhite">执白</button>
      </div>
      <div class="guess-foot">
        <button id="ogBtnSkip">跳过（默认房主执黑）</button>
      </div>
    </div>
  </div>
  <canvas id="board"></canvas>

<script>
'use strict';

/* ============================================================
 * 零、扩展接口：游戏注册表（GameAdapter）
 * ------------------------------------------------------------
 * 设计目标：把本页做成“框架 + 游戏”的架构——五子棋是第一个（也是
 * 目前唯一完整的）游戏，后续的国际象棋、围棋、中国象棋通过同一个
 * 接口接入。所有游戏统一注册到 GAME_REGISTRY，界面“游戏”下拉框会
 * 自动列出已注册的游戏，无需改动框架代码。
 *
 * 每个游戏实现一个“适配器对象”（GameAdapter），核心约定如下：
 *   id / name            必填。唯一标识与界面显示名
 *   modes                支持的模式数组，如 ['pvp', 'pve']
 *   boardSizes           可选格数数组；null 表示固定棋盘（如国际象棋 8×8）
 *   defaultBoardSize     默认格数（有 boardSizes 时建议给出）
 *   aiLevels             AI 难度表，如 { easy:'简单', medium:'中等' }；null 表示暂无 AI
 *   defaultAiLevel       默认难度（有 aiLevels 时建议给出）
 *   supportsEdu          是否支持教学点评（人机模式下才显示相关开关）
 *   onEnter()            切到本游戏时调用：负责初始化与首帧绘制
 *   onExit()             切走时调用：负责清理定时器、临时监听器等
 *   onCanvasClick(e)     画布点击事件（e 为原生事件对象）
 *   onUndo()/onRestart() 悔棋 / 重新开始（未实现可省略，框架会忽略）
 *   onModeChange(mode)   双人 / 人机切换
 *   onBoardSizeChange(n) 棋盘格数变化
 *   onAiLevelChange(lv)  AI 难度变化
 *   onEduToggle(ok)      教学点评开关（可选能力，未实现时忽略点击）
 *   onHintToggle(ok)     推荐点开关（可选能力）
 *
 * 接入新游戏三步：
 *   1) 复制 games/_adapter-template.js 到 games/你的游戏.js
 *   2) 按文件里的 TODO 逐项实现适配器；
 *   3) 在页面末尾用 <script src="games/你的游戏.js"> 标签引入本文件即可
 *      （注意：注释里不要出现 script 的结束标签字样，否则会被 HTML
 *      解析器当作脚本块终点，导致后续代码全部失效）
 * 注册后框架自动把它加入“游戏”下拉框，并按其能力显隐设置项
 * ============================================================ */

/** 游戏注册表：id → 适配器对象。所有游戏都登记在这里 */
const GAME_REGISTRY = {};

/** 当前激活的游戏 id（默认 'gomoku'） */
let activeGameId = null;

/** 注册一个游戏适配器，并刷新“游戏”下拉框 */
function registerGame(id, adapter) {
  GAME_REGISTRY[id] = adapter;
  refreshGameSelect();
}

/** 获取当前激活的游戏适配器 */
function getActiveGame() {
  return GAME_REGISTRY[activeGameId] || null;
}

/** 重建“游戏”下拉框的选项，尽量保持当前选择不变 */
function refreshGameSelect() {
  const current = gameSelect.value || activeGameId || 'gomoku';
  gameSelect.innerHTML = '';
  for (const id of Object.keys(GAME_REGISTRY)) {
    const opt = document.createElement('option');
    opt.value = id;
    opt.textContent = GAME_REGISTRY[id].name;
    gameSelect.appendChild(opt);
  }
  if (GAME_REGISTRY[current]) gameSelect.value = current;
}

/** 切换到指定游戏：先让旧游戏收尾，再让新游戏接管 */
function switchGame(id) {
  const target = GAME_REGISTRY[id];
  if (!target) return;
  const old = getActiveGame();
  if (old && old.onExit) old.onExit();
  activeGameId = id;
  setFrameworkControlsEnabled(true);   // 先恢复控件，可用性交给新游戏决定
  syncSettingsVisibility(target);      // 按新游戏能力显隐/重建设置项
  if (target.onEnter) target.onEnter();
}

/**
 * 按当前游戏的声明能力，显隐并重建设置区控件：
 * - 棋盘格数：只有声明了 boardSizes 的游戏才显示
 * - AI 难度：人机模式且声明了 aiLevels 才显示，选项由游戏提供；
 * - 教学点评 / 推荐点：人机模式且 supportsEdu 才显示。 */
function syncSettingsVisibility(g) {
  const hasSizes = !!(g.boardSizes && g.boardSizes.length);
  const hasPve = g.modes && g.modes.indexOf(MODE_PVE) !== -1;

  boardSizeLabel.style.display = hasSizes ? '' : 'none';
  if (hasSizes) {                       // 按游戏的格数表重建下拉选项
    boardSizeSelect.innerHTML = '';
    for (const n of g.boardSizes) {
      const opt = document.createElement('option');
      opt.value = n;
      opt.textContent = n + '×' + n;
      boardSizeSelect.appendChild(opt);
    }
    boardSizeSelect.value = String(g.defaultBoardSize || g.boardSizes[g.boardSizes.length - 1]);
  }

  aiLevelLabel.style.display = (hasPve && g.aiLevels) ? '' : 'none';
  if (g.aiLevels) {                     // 按游戏的难度表重建下拉选项
    aiLevelSelect.innerHTML = '';
    for (const lv of Object.keys(g.aiLevels)) {
      const opt = document.createElement('option');
      opt.value = lv;
      opt.textContent = g.aiLevels[lv];
      aiLevelSelect.appendChild(opt);
    }
    aiLevelSelect.value = g.defaultAiLevel || Object.keys(g.aiLevels)[0];
  }

  eduLabel.style.display = (hasPve && g.supportsEdu) ? '' : 'none';
  hintLabel.style.display = eduLabel.style.display;
  // 猜先开关：双人/人机模式通用，在线模式固定黑白（房主黑、加入者白），无需猜先
  guessLabel.style.display = (g.modes && (g.modes.indexOf(MODE_PVP) !== -1 || hasPve)) ? '' : 'none';
  // 胜率显示：仅对支持教学点评（即完整实现）的人机游戏开启
  winRateLabel.style.display = (hasPve && g.supportsEdu) ? '' : 'none';
}

/** 框架级控件总开关：切到“开发中”的游戏时整体禁用，只留游戏下拉框 */
function setFrameworkControlsEnabled(enabled) {
  const controls = [
    btnPvp, btnPve, btnOnline, btnUndo, btnRestart,
    boardSizeSelect, aiLevelSelect, eduModeToggle, showHintToggle, guessFirstToggle, winRateToggle
  ];
  for (const el of controls) el.disabled = !enabled;
}

