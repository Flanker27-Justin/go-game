function syncModeButtons() {
  btnPvp.classList.toggle('active', gameMode === MODE_PVP);
  btnPve.classList.toggle('active', gameMode === MODE_PVE);
  btnOnline.classList.toggle('active', gameMode === MODE_ONLINE);
