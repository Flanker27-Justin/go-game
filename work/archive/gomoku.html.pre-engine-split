/**
 * 同步设置区控件的可用状态：
 * AI 难度与教学相关控件只在人机模式下可用；切回双人时强制关闭教学并清空面板。 */
function syncControls() {
  const pve = gameMode === MODE_PVE;
  const online = gameMode === MODE_ONLINE;
  aiLevelSelect.disabled = !pve;
  eduModeToggle.disabled = !pve;
  showHintToggle.disabled = !pve;
  // 联机猜先：入房前可开关（建房时提交给服务器），入房后锁定；双人/人机照旧可用
  guessFirstToggle.disabled = online ? !!(ws && ws.readyState === WebSocket.OPEN && roomCode) : false;
  winRateToggle.disabled = !pve;        // 胜率显示仅人机模式有意义
  // 在线对局：房间大小由建房时决定，入房后禁止再改（防止双方棋盘不一致）
  boardSizeSelect.disabled = online && !!(ws && ws.readyState === WebSocket.OPEN) && !!roomCode;
  btnUndo.disabled = online;            // 在线对局不允许单方悔棋
  btnRestart.disabled = online;         // 在线对局不允许单方重开
  onlinePanel.style.display = online ? '' : 'none';
  if (!pve) {
    eduMode = false;
    eduModeToggle.checked = false;
    hintMove = null;
    clearComment();
  }
}

/* ============================================================
 * 九·五、在线对战（WebSocket 房间）
 * 说明：通过 WebSocket 与服务器通信，实现“电脑开房、手机进房”的
 * 双人实时对弈。协议为 JSON 消息，服务器见 outputs/gomoku-server.js。
 * ------------------------------------------------------------
 * 消息一览：
 *   客户端 → 服务器：create / join{room} / move{r,c} / reset
 *   服务器 → 客户端：room_created / room_joined / peer_joined /
 *                   move / reset / peer_left / game_over / error
 * 状态约束：创建者执黑先手，加入者执白；服务器校验“是否轮到自己”，
 * 客户端也做同样的提前拦截，避免无效点击与网络往返。
 * ============================================================ */

/** 建立 WebSocket 连接；action 为 'create' 或 'join'，code 为房间号 */
function onlineConnect(action, code, token) {
  if (ws && (ws.readyState === WebSocket.OPEN || ws.readyState === WebSocket.CONNECTING)) {
    onlineStatusEl.textContent = '已连接，请勿重复操作';
    return;
  }
  let url = wsAddrInput.value.trim();
  if (!url) {
    // 留空时自动使用“当前页面地址”，如 http://192.168.1.5:8123/ → ws://192.168.1.5:8123/ws
    url = (location.protocol === 'https:' ? 'wss://' : 'ws://') + location.host + '/ws';
  } else {
    if (!/^wss?:\/\//i.test(url)) url = 'ws://' + url;               // 没写协议就补 ws://
    if (!/\/ws$/.test(url)) url = url.replace(/\/+$/, '') + '/ws';   // 没写路径就补 /ws
  }
  onlineStatusEl.textContent = '正在连接服务器…';
  try {
    ws = new WebSocket(url);
  } catch (err) {
    onlineStatusEl.textContent = '连接失败：' + err.message;
    return;
  }
  ws.onopen = () => {
    intentionalLeave = false;
    reconnectStart = 0;                    // 连接成功即重置重连退避
    reconnectAttempts = 0;
    if (action === 'reconnect') {
      onlineStatusEl.textContent = '已连上服务器，正在恢复对局…';
      onlineSend({ type: 'reconnect', room: code, token });
    } else {
      onlineStatusEl.textContent = action === 'create' ? '正在创建房间…' : '正在加入房间 ' + code + '…';
      const payload = { type: action, room: code };
      if (action === 'create') {
        payload.boardSize = parseInt(boardSizeSelect.value, 10);  // 建房携带棋盘格数
        payload.guess = guessFirstToggle.checked;   // 携带联机猜先开关：双方就位后先猜先定黑白
      }
      onlineSend(payload);
    }
    onlineUpdateControls();
  };
  ws.onmessage = (evt) => {
    let msg;
    try { msg = JSON.parse(evt.data); } catch (err) { return; }  // 忽略非 JSON 消息
    onlineHandleMessage(msg);
  };
  ws.onclose = () => {
    const hadSession = !!loadOnlineSession();
    onlineReady = false;
    myColor = null;
    isHost = false;
    roomCode = null;
    ws = null;
    inviteRow.style.display = 'none';
    roomCodeBig.style.display = 'none';
    qrWrap.style.display = 'none';
    clearAwayCountdown();
    closeOnlineGuess();          // 断线/离开时收起联机猜先弹窗
    resetOnlineUi();            // 玩家栏/聊天/格数锁定复位
    onlineUpdateControls();
    // 主动断开 → 真正离开；非主动断开且还有重连凭证 → 自动重连（刷新页面/断网可回房）
    if (intentionalLeave || !hadSession) {
      clearOnlineSession();
      onlineStatusEl.textContent = '已断开连接';
      updateStatus();
      return;
    }
    onlineStatusEl.textContent = '网络中断，正在重连…';
    scheduleReconnect();
  };
  ws.onerror = () => { /* 出错后浏览器会自动触发 onclose，统一在那里收尾 */ };
}

/** 发送 JSON 消息；未连接或连接中则静默忽略 */
function onlineSend(obj) {
  if (ws && ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify(obj));
}

/** 处理服务器下发的所有消息类型 */
function onlineHandleMessage(msg) {
  switch (msg.type) {
    case 'room_created':
      roomCode = msg.room;
      myColor = msg.guessPending ? null : BLACK;   // 猜先开启时颜色待定，等 color_assigned
      isHost = true;
      saveOnlineSession(msg.room, msg.token);       // 保存重连凭证（刷新/断网可自动回房）
      applyOnlineRoomSize(msg.boardSize);           // 棋盘大小以服务器为准并锁定格数选择器
      showInviteLink(buildInviteUrl(roomCode));     // 生成并显示一键邀请链接
      roomCodeBig.textContent = '房间号 ' + roomCode;
      roomCodeBig.style.display = '';
      qrWrap.style.display = drawQr(qrCanvas, inviteLinkInput.value) ? '' : 'none';  // 二维码入局
      onlineActions.style.display = '';             // 房主可先设置昵称（通话待对方加入）
      onlineStatusEl.textContent = msg.guessPending
        ? '房间已创建（将猜先公平决定谁执黑），等待对方加入…'
        : '房间已创建（你执黑先行），等待对方加入…';
      copyInviteLink(true);                         // 建房后自动复制邀请链接
      onlineUpdateControls();
      updateStatus();
      break;
    case 'room_joined':
      roomCode = msg.room;
      myColor = msg.guessPending ? null : WHITE;   // 猜先开启时颜色待定，等 color_assigned
      isHost = false;
      onlineReady = true;      // 已加入房间（猜先开启时先猜先再开局）
      saveOnlineSession(msg.room, msg.token);       // 保存重连凭证
      applyOnlineRoomSize(msg.boardSize);           // 按房间大小重建棋盘（加入方以服务器为准）
      onlineStatusEl.textContent = msg.guessPending
        ? '已加入房间 ' + roomCode + '，等待猜先…'
        : '已加入房间 ' + roomCode + '（你执白）';
      onlineActions.style.display = '';             // 加入方也可聊天/通话/改昵称
      inviteRow.style.display = 'none';   // 加入方不需要邀请链接
      roomCodeBig.style.display = 'none';
      qrWrap.style.display = 'none';
      onlineUpdateControls();
      updateStatus();
      break;
    case 'peer_joined':
      onlineReady = true;      // 房主视角：对方已就位（猜先开启时先猜先再开局）
      onlineStatusEl.textContent = msg.guessPending ? '对方已加入，开始猜先…' : '对方已加入，对局开始！';
      // 邀请区在对局中保留（紧凑条），方便对方中途断线后重新加入
      onlineActions.style.display = '';
      updateStatus();
      break;
    case 'guest_left':
      // 对方（白棋）离开：房间与棋盘保留，邀请区重新出现，可再次发链接
      onlineReady = false;
      clearAwayCountdown();
      onlineStatusEl.textContent = '对方已离开，把邀请链接再次发给他即可重新加入（房间保留）';
      showInviteLink(buildInviteUrl(roomCode));       // 重新显示邀请链接
      roomCodeBig.style.display = '';
      qrWrap.style.display = drawQr(qrCanvas, inviteLinkInput.value) ? '' : 'none';
      inviteRow.classList.add('flash');
      setTimeout(() => inviteRow.classList.remove('flash'), 2500);
      if (callState !== 'idle') hangupCall('对方已离开，通话结束');
      updateStatus();
      break;
    case 'nickname_update':
      if (msg.from === 'host') {
        myNickname = isHost ? msg.name : '';
        peerNickname = isHost ? '' : msg.name;
      } else {
        myNickname = isHost ? '' : msg.name;
        peerNickname = isHost ? msg.name : '';
      }
      updateOnlinePlayers();
      break;
    case 'board_size_changed':
      // 房主修改棋盘大小 → 双方按新大小清空重开一局（黑方先手）
      applyOnlineRoomSize(msg.boardSize);
      init(MODE_ONLINE);
      onlineStatusEl.textContent = '棋盘已切换为 ' + msg.boardSize + '×' + msg.boardSize + '，重开一局';
      updateStatus();
      if (onlineGuess) openOnlineGuess(onlineGuess.selector);   // 猜先中改大小 → 猜先弹窗重开
      break;
    case 'guess_start':
      // 服务器权威猜先开始：selector 为被选中“先猜硬币面”的一方（'host'|'guest'）
      openOnlineGuess(msg.selector);
      onlineStatusEl.textContent = '对方已加入，开始猜先…';
      updateStatus();
      break;
    case 'guess_won':
      onOnlineGuessWon(msg.winner);
      break;
    case 'color_assigned':
      // 猜先完成：按角色取服务器分配的颜色，清空棋盘重开一局（黑先）
      myColor = (isHost ? msg.hostColor : msg.guestColor) === 'black' ? BLACK : WHITE;
      closeOnlineGuess();
      applyOnlineRoomSize(msg.boardSize);
      init(MODE_ONLINE);
      statusEl.textContent = '猜先完成：你执' + (myColor === BLACK ? '黑' : '白') + '，对局开始！';
      updateStatus();
      break;
    case 'call_offer':
      onCallOffer(msg);
      break;
    case 'call_answer':
      onCallAnswer(msg);
      break;
    case 'call_ice':
      onCallIce(msg);
      break;
    case 'call_end':
      onCallEnd();
      break;
    case 'call_reject':
      onCallReject();
      break;
    case 'peer_left':
      // 房主离开：对局作废；通话随之结束
      onlineReady = false;
      clearAwayCountdown();
      onlineStatusEl.textContent = '对方已离开，对局结束';
      if (callState !== 'idle') hangupCall('对方已离开，通话结束');
      updateStatus();
      break;
    case 'move':
      onlineApplyRemoteMove(msg.r, msg.c);
      break;
    case 'reset':
      init(MODE_ONLINE);       // 双方同步重开（保留在线连接与房间与重连凭证）
      break;
    case 'peer_reconnecting':
      // 对方断线/刷新：进入重连窗口，本地暂停对局（不能落子）
      onlineReady = false;
      onlineStatusEl.textContent = '对方暂时离开，正在重连…';
      startAwayCountdown();     // 每秒刷新剩余秒数，让对方知道窗口还剩多久
      updateStatus();
      break;
    case 'peer_reconnected':
      onlineReady = true;
      clearAwayCountdown();
      onlineStatusEl.textContent = '对方已重连，继续对局！';
      updateStatus();
      break;
    case 'room_snapshot':
      applySnapshot(msg);      // 重连成功：用服务器权威快照恢复本地局面
      break;
    case 'chat':
      appendChat(msg);          // 双方实时聊天（发送方也会收到回显，保证顺序一致）
      break;
    case 'game_over':
      // 客户端本地已判胜并高亮，这里仅补充面板文案
      if (msg.winner) {
        const iWin = (msg.winner === 'black' && myColor === BLACK) || (msg.winner === 'white' && myColor === WHITE);
        onlineStatusEl.textContent = '对局结束：' + (iWin ? '你赢了！' : '你输了…');
      } else {
        onlineStatusEl.textContent = '对局结束：平局';
      }
      updateStatus();
      break;
    case 'error':
      onlineStatusEl.textContent = '错误：' + msg.message;
      break;
    default:
      break;  // 未知类型忽略，向前兼容
  }
}

/** 应用对方落子：与本地落子共用 placeStone，但不再回传消息（避免循环） */
function onlineApplyRemoteMove(r, c) {
  if (gameOver || !inBoard(r, c) || board[r][c] !== EMPTY) return;
  placeStone(r, c);
}

/* ---------------- 断线重连（刷新页面/断网自动回房） ---------------- */

/** 把房间会话（房间号 + 重连 token）存入 sessionStorage：刷新/断线可自动回房 */
function saveOnlineSession(room, token) {
  try { sessionStorage.setItem(ONLINE_SESSION_KEY, JSON.stringify({ room, token })); } catch (err) { /* 隐私模式等场景忽略 */ }
}

/** 读取上次会话；无效或不存在返回 null */
function loadOnlineSession() {
  try {
    const raw = sessionStorage.getItem(ONLINE_SESSION_KEY);
    if (!raw) return null;
    const s = JSON.parse(raw);
    if (!s || !s.room || !s.token) return null;
    return s;
  } catch (err) { return null; }
}

/** 清除会话：主动断开 / 重连超时后调用 */
function clearOnlineSession() {
  try { sessionStorage.removeItem(ONLINE_SESSION_KEY); } catch (err) { /* 忽略 */ }
}

/**
 * 指数退避自动重连：1s → 2s → 4s → … 上限 10s，总时长不超过 60s。
 * 只在“非主动断开且还有会话凭证”时由 ws.onclose 触发。 */
function scheduleReconnect() {
  if (reconnectTimer || !loadOnlineSession()) return;
  if (reconnectStart === 0) reconnectStart = Date.now();
  if (Date.now() - reconnectStart > 60000) {
    clearOnlineSession();
    onlineStatusEl.textContent = '重连超时，请重新创建或加入房间';
    updateStatus();
    return;
  }
  const delay = Math.min(1000 * Math.pow(2, reconnectAttempts), 10000);
  reconnectAttempts++;
  reconnectTimer = setTimeout(() => {
    reconnectTimer = null;
    const s = loadOnlineSession();
    if (!s) return;
    onlineConnect('reconnect', s.room, s.token);
  }, delay);
}

/**
 * 应用服务器权威快照（重连成功后调用）：
 * 直接重建棋盘/回合/胜负状态，不走 placeStone，避免落子消息重放。
 * 服务端 turn: 0=黑 1=白（下一步行动方）。 */
function applySnapshot(msg) {
  if (msg.boardSize) applyOnlineRoomSize(msg.boardSize);   // 重连先恢复房间棋盘大小（含画布）
  if (msg.room) roomCode = msg.room;                       // 重连恢复房间号（聊天/格数锁定依赖）
  board = msg.board.map((row) => row.slice());
  myColor = msg.color === 'black' ? BLACK : WHITE;   // 快照带角色，恢复我方执子颜色
  isHost = msg.role ? msg.role === 'host' : msg.color === 'black';   // 猜先后颜色与角色解耦，以 role 为准
  myNickname = msg.nicknames ? (msg.nicknames[isHost ? 'host' : 'guest'] || '') : myNickname;
  peerNickname = msg.nicknames ? (msg.nicknames[isHost ? 'guest' : 'host'] || '') : peerNickname;
  moveCount = 0;
  for (const row of board) for (const v of row) if (v !== EMPTY) moveCount++;
  gameOver = !!msg.over;
  winLine = null;                               // 重连不恢复胜利连线，只恢复胜负状态
  lastMove = msg.lastMove ? [msg.lastMove[0], msg.lastMove[1]] : null;
  if (msg.over && msg.winner) {                 // 终局：让状态栏显示真正的赢家
    currentPlayer = msg.winner === 'black' ? BLACK : WHITE;
  } else {
    currentPlayer = msg.turn === 0 ? BLACK : WHITE;
  }
  hintMove = null;
  clearComment();
  onlineReady = true;
  onlineActions.style.display = '';          // 重连后恢复操作行（昵称/通话）
  inviteRow.style.display = 'none';
  roomCodeBig.style.display = 'none';
  qrWrap.style.display = 'none';
  onlineStatusEl.textContent = '重连成功，继续对局！';
  onlineUpdateControls();
  updateStatus();
  draw();
}

/** 主动断开连接并清理在线状态（离开在线模式 / 切换游戏时也会调用） */
function onlineLeave() {
  // 先通知服务器“主动离开”（不等重连窗口），随后本地收尾
  if (ws && ws.readyState === WebSocket.OPEN) {
    try { ws.send(JSON.stringify({ type: 'leave' })); } catch (err) { /* 忽略 */ }
  }
  intentionalLeave = true;
  clearTimeout(reconnectTimer);
  reconnectTimer = null;
  reconnectStart = 0;
  clearOnlineSession();
  if (ws) {
    try { ws.close(); } catch (err) { /* 忽略关闭异常 */ }
    ws = null;
  }
  onlineReady = false;
  myColor = null;
  isHost = false;
  roomCode = null;
  onlineStatusEl.textContent = '已断开连接';
  inviteRow.style.display = 'none';
  roomCodeBig.style.display = 'none';
  qrWrap.style.display = 'none';
  clearAwayCountdown();
  closeOnlineGuess();            // 离开在线模式时收起联机猜先弹窗
  resetOnlineUi();
  onlineUpdateControls();
  updateStatus();
}

/** 根据连接状态刷新在线面板按钮的可用性 */
function onlineUpdateControls() {
  const connected = !!(ws && ws.readyState === WebSocket.OPEN);
  btnCreateRoom.disabled = connected;
  btnJoinRoom.disabled = connected;
  btnLeaveRoom.disabled = !connected;
  wsAddrInput.disabled = connected;
  roomCodeInput.disabled = connected;
  const inRoom = connected && !!roomCode;      // 已加入房间：聊天/通话可用
  chatInput.disabled = !inRoom;
  btnChatSend.disabled = !inRoom;
  nicknameInput.disabled = !inRoom;
  chatQuickRow.style.pointerEvents = inRoom ? '' : 'none';
  chatQuickRow.style.opacity = inRoom ? '' : '0.5';
  // 在线棋盘大小：未入房时可选；入房后仅房主在“未落子”时可改（发送给服务器同步双方）
  const hasStones = board && board.some((row) => row.some((v) => v !== EMPTY));
  const canChangeSize = gameMode === MODE_ONLINE
    ? !inRoom || isHost
    : true;
  boardSizeSelect.disabled = gameMode === MODE_ONLINE ? !canChangeSize : false;
  // 通话按钮：入房且对方在线才可用（重连窗口内对方不在线则置灰）
  const canCall = inRoom && onlineReady;
  btnCallAudio.disabled = !canCall || callState !== 'idle';
  btnCallVideo.disabled = !canCall || callState !== 'idle';
  updateOnlinePlayers();
}

/* ---------------- 在线可视化：玩家栏 / 聊天 / 重连倒计时 ---------------- */

/** 应用房间棋盘大小：以服务器为准锁定格数选择器，并重建棋盘与画布 */
function applyOnlineRoomSize(size) {
  size = Number(size);
  if (!BOARD_SIZES.includes(size)) size = DEFAULT_BOARD_SIZE;
  boardSize = size;
  boardSizeSelect.value = String(size);
  board = Array.from({ length: size }, () => Array(size).fill(EMPTY));
  moveCount = 0;
  resizeCanvas();
  draw();
}

/** 刷新在线玩家栏：执子颜色、回合指示、最近落子；未入房时显示等待状态 */
function updateOnlinePlayers() {
  if (gameMode !== MODE_ONLINE) return;
  if (!roomCode || !myColor) {
    const guessing = !!onlineGuess;          // 联机猜先进行中：双方颜色未定
    myPlayerDot.className = 'player-dot';
    peerPlayerDot.className = 'player-dot';
    myPlayerSub.textContent = guessing ? '猜先中…' : '未加入房间';
    peerPlayerSub.textContent = guessing ? '猜先中…' : '等待加入…';
    myPlayerName.textContent = '你';
    peerPlayerName.textContent = '对方';
    myPlayerTurn.textContent = '';
    peerPlayerTurn.textContent = '';
    myPlayerCard.classList.remove('active');
    peerPlayerCard.classList.remove('active');
    nicknameInput.value = myNickname || '';
    return;
  }
  const peerColor = myColor === BLACK ? WHITE : BLACK;
  myPlayerDot.className = 'player-dot ' + (myColor === BLACK ? 'black' : 'white');
  peerPlayerDot.className = 'player-dot ' + (peerColor === BLACK ? 'black' : 'white');
  myPlayerName.textContent = (myNickname || '你') + '（' + colorName(myColor) + '）';
  peerPlayerName.textContent = (peerNickname || '对方') + '（' + colorName(peerColor) + '）';
  if (document.activeElement !== nicknameInput) nicknameInput.value = myNickname || '';
  myPlayerSub.textContent = '第 ' + moveCount + ' 手';
  peerPlayerSub.textContent = lastMove ? '最近落子 ' + formatPos(lastMove[0], lastMove[1]) : '尚未落子';
  peerPlayerSub.textContent += !onlineReady ? ' · 对方不在线' : '';
  const myTurn = !gameOver && onlineReady && currentPlayer === myColor;
  const peerTurn = !gameOver && onlineReady && currentPlayer === peerColor;
  myPlayerCard.classList.toggle('active', myTurn);
  peerPlayerCard.classList.toggle('active', peerTurn);
  myPlayerTurn.textContent = myTurn ? '● 你的回合' : '';
  peerPlayerTurn.textContent = peerTurn ? '● 对方思考中…' : '';
}

/** 追加一条聊天消息：气泡化（自己靠右、对方靠左）、带昵称与时间戳；折叠时累计未读 */
function appendChat(msg) {
  // 聊天默认折叠：收到消息时点亮开关按钮并累计未读数字
  if (chatWrap.style.display === 'none') {
    chatToggleRow.classList.add('hot');
    unreadChat++;
    chatBadge.textContent = String(unreadChat);
    chatBadge.style.display = '';
  }
  const mine = (msg.from === 'host') === isHost;
  const div = document.createElement('div');
  div.className = 'chat-msg' + (mine ? ' mine' : '');
  const bubble = document.createElement('div');
  bubble.className = 'bubble';
  const who = document.createElement('span');
  who.className = 'who';
  who.textContent = (mine ? (myNickname || '我') : (peerNickname || '对方')) + '（' + (msg.color === 'black' ? '黑' : '白') + '）';
  const txt = document.createElement('span');
  txt.textContent = String(msg.text || '');
  bubble.appendChild(who);
  bubble.appendChild(txt);
  div.appendChild(bubble);
  const meta = document.createElement('div');
  meta.className = 'meta';
  const d = new Date(msg.ts || Date.now());
  meta.textContent = (d.getHours() < 10 ? '0' : '') + d.getHours() + ':' + (d.getMinutes() < 10 ? '0' : '') + d.getMinutes();
  div.appendChild(meta);
  chatLog.appendChild(div);
  chatLog.scrollTop = chatLog.scrollHeight;        // 自动滚到底部
}

/** 发送聊天消息（空消息或未入房忽略） */
function sendChat() {
  const text = chatInput.value.trim();
  if (!text || !roomCode) return;
  onlineSend({ type: 'chat', text });
  chatInput.value = '';
}

/* ---------------- 语音/视频通话（WebRTC，信令走 WebSocket） ---------------- */

/** 公共 STUN 服务器：用于 NAT 打洞建立 P2P 媒体通道。跨严格 NAT 时可自行配置 TURN 服务器加入此数组 */
const ICE_SERVERS = [{ urls: 'stun:stun.l.google.com:19302' }];

/** 新建 RTCPeerConnection：绑定 ICE 候选发送与远端音视频流展示 */
function makePeerConnection() {
  pc = new RTCPeerConnection({ iceServers: ICE_SERVERS });
  pc.onicecandidate = (e) => {
    if (e.candidate) onlineSend({ type: 'call_ice', candidate: e.candidate });
  };
  pc.ontrack = (e) => {
    if (e.streams && e.streams[0]) remoteVideo.srcObject = e.streams[0];
  };
}

/** 刷新通话按钮与状态文案 */
function setCallUi() {
  const inCall = callState !== 'idle';
  btnCallAudio.style.display = inCall ? 'none' : '';
  btnCallVideo.style.display = inCall ? 'none' : '';
  btnHangupCall.style.display = (callState === 'outgoing' || callState === 'active') ? '' : 'none';
  btnHangupCall2.style.display = callState === 'active' ? '' : 'none';
  callStatus.textContent =
    callState === 'outgoing' ? (callMode === 'video' ? '正在呼叫（视频）…' : '正在呼叫…') :
    callState === 'ringing' ? '等待接听…' : '';
}

/**
 * 发起语音/视频通话：先申请麦克风/摄像头（需 HTTPS 安全上下文），
 * 再把 offer 通过服务器转发给对端。30 秒无应答自动取消。 */
function startCall(mode) {
  if (callState !== 'idle' || !roomCode || !onlineReady) return;
  if (!window.isSecureContext) {
    callStatus.textContent = '语音/视频需要 HTTPS 访问（cpolar 公网 https 或本机 localhost）';
    return;
  }
  callMode = mode;
  navigator.mediaDevices.getUserMedia({ audio: true, video: mode === 'video' })
    .then((stream) => {
      localStream = stream;
      localVideo.srcObject = stream;
      callArea.style.display = '';                  // 先显示本地预览
      makePeerConnection();
      stream.getTracks().forEach((t) => pc.addTrack(t, stream));
      pc.createOffer().then((offer) => {
        pc.setLocalDescription(offer);
        onlineSend({ type: 'call_offer', mode, sdp: offer });
      });
      callState = 'outgoing';
      setCallUi();
      callTimeout = setTimeout(() => {
        if (callState === 'outgoing') hangupCall('对方未接听，已自动取消');
      }, 30000);
    })
    .catch((err) => {
      callStatus.textContent = '无法打开麦克风/摄像头：' + (err && err.message ? err.message : '被拒绝');
    });
}

/** 收到来电：弹出来电横幅；正在通话中则直接拒绝（忙） */
function onCallOffer(msg) {
  if (callState !== 'idle') { onlineSend({ type: 'call_reject' }); return; }
  if (!roomCode) return;
  if (!window.isSecureContext) {
    callStatus.textContent = '语音/视频需要 HTTPS 访问';
    return;
  }
  callMode = msg.mode;
  incomingOffer = msg;
  callState = 'ringing';
  incomingCall.style.display = '';
  incomingText.textContent = (msg.from === 'host' ? '房主' : '对方') + '请求' + (msg.mode === 'video' ? '视频' : '语音') + '通话…';
  setCallUi();
}

/** 接听来电：申请本地媒体 → 回复 answer，进入通话 */
function acceptCall() {
  if (!incomingOffer || callState !== 'ringing') return;
  incomingCall.style.display = 'none';
  navigator.mediaDevices.getUserMedia({ audio: true, video: callMode === 'video' })
    .then((stream) => {
      localStream = stream;
      localVideo.srcObject = stream;
      callArea.style.display = '';
      makePeerConnection();
      stream.getTracks().forEach((t) => pc.addTrack(t, stream));
      pc.setRemoteDescription(incomingOffer.sdp)
        .then(() => pc.createAnswer())
        .then((answer) => {
          pc.setLocalDescription(answer);
          onlineSend({ type: 'call_answer', sdp: answer });
        });
      callState = 'active';
      setCallUi();
    })
    .catch((err) => {
      callStatus.textContent = '无法打开麦克风/摄像头：' + (err && err.message ? err.message : '被拒绝');
      cleanupCall();
    });
}

/** 拒绝来电 */
function rejectCall() {
  incomingCall.style.display = 'none';
  onlineSend({ type: 'call_reject' });
  callStatus.textContent = '已拒绝来电';
  cleanupCall();
}

/** 对方接受通话：把 answer 写入本地，进入通话状态 */
function onCallAnswer(msg) {
  if (callState !== 'outgoing' || !pc) return;
  clearTimeout(callTimeout);
  callTimeout = null;
  pc.setRemoteDescription(msg.sdp).then(() => {
    callState = 'active';
    setCallUi();
  }).catch(() => { hangupCall('通话建立失败'); });
}

/** 收到远端 ICE 候选：加入连接（可能先于 answer 到达，忽略失败即可） */
function onCallIce(msg) {
  if (!pc) return;
  pc.addIceCandidate(msg.candidate).catch(() => { /* 候选未就绪属正常 */ });
}

/** 对方挂断 */
function onCallEnd() {
  hangupCall('对方已挂断');
}

/** 对方拒绝 */
function onCallReject() {
  hangupCall('对方拒绝了通话');
}

/**
 * 结束通话：主动挂断时通知对方；清理 PC 与媒体流。
 * @param {string} [reason] 结束后显示的状态提示（可空）
 * @param {boolean} [silent] 为 true 时不提示（页面离开/断开等场景） */
function hangupCall(reason, silent) {
  if (callState === 'outgoing' || callState === 'active') onlineSend({ type: 'call_end' });
  cleanupCall();
  if (reason && !silent) {
    callStatus.textContent = reason;
    setTimeout(() => { if (callStatus.textContent === reason) callStatus.textContent = ''; }, 4000);
  }
}

/** 清理通话资源：关闭连接、停掉本地媒体、复位 UI 状态 */
function cleanupCall() {
  clearTimeout(callTimeout);
  callTimeout = null;
  if (pc) { try { pc.close(); } catch (e) { /* 忽略 */ } pc = null; }
  if (localStream) { localStream.getTracks().forEach((t) => t.stop()); localStream = null; }
  remoteVideo.srcObject = null;
  localVideo.srcObject = null;
  incomingOffer = null;
  callState = 'idle';
  muted = false;
  cameraOff = false;
  incomingCall.style.display = 'none';
  callArea.style.display = 'none';
  btnMuteAudio.textContent = '🎙 静音';
  btnToggleCamera.textContent = '📷 关摄像头';
  setCallUi();
}

/** 麦克风静音切换 */
function toggleMute() {
  if (!localStream) return;
  muted = !muted;
  localStream.getAudioTracks().forEach((t) => { t.enabled = !muted; });
  btnMuteAudio.textContent = muted ? '🔇 已静音' : '🎙 静音';
}

/** 摄像头开关切换 */
function toggleCamera() {
  if (!localStream) return;
  cameraOff = !cameraOff;
  localStream.getVideoTracks().forEach((t) => { t.enabled = !cameraOff; });
  btnToggleCamera.textContent = cameraOff ? '📷 开摄像头' : '📷 关摄像头';
}

/** 对方断线：启动约 60s 的重连窗口倒计时（每秒刷新状态栏） */
function startAwayCountdown() {
  clearAwayCountdown();
  awayDeadline = Date.now() + 60000;
  awayTimer = setInterval(() => {
    const left = Math.max(0, Math.ceil((awayDeadline - Date.now()) / 1000));
    onlineStatusEl.textContent = '对方暂时离开，正在重连…（' + left + ' 秒）';
    if (left <= 0) clearAwayCountdown();
  }, 1000);
}

/** 停止重连窗口倒计时 */
function clearAwayCountdown() {
  if (awayTimer) { clearInterval(awayTimer); awayTimer = null; }
}

