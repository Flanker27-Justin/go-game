/* ============================================================
 * 四、工具函数
 * 说明：与具体规则无关的小工具，坐标换算、越界判断等
 * ============================================================ */
/** (r, c) 是否在棋盘范围内 */
function inBoard(r, c) {
  return r >= 0 && r < boardSize && c >= 0 && c < boardSize;
}

/** 列号 c 对应的画布 x 坐标（列号 0 在左边） */
function boardX(c) { return MARGIN + c * CELL_SIZE; }

/** 行号 r 对应的画布 y 坐标（行号 0 在上边） */
function boardY(r) { return MARGIN + r * CELL_SIZE; }

/** 列号转字母：0→A、1→B…（19 路棋盘用 A~S） */
function colToLabel(c) { return String.fromCharCode(65 + c); }

/** 坐标转人类可读位置，如 (6,6) → "G7"（字母为列、数字为行） */
function formatPos(r, c) { return colToLabel(c) + (r + 1); }

/** 颜色转中文名，用于状态栏与教学点评文案 */
function colorName(color) { return color === BLACK ? '黑棋' : '白棋'; }

/**
 * 双人模式：某执子颜色对应的玩家标签
 * 猜先决定玩家1执黑还是执白，状态栏据此显示“黑棋（玩家1）/白棋（玩家2）”。 */
function pvpOwner(color) {
  if (gameMode !== MODE_PVP) return '';
  return color === p1Color ? '（玩家1）' : '（玩家2）';
}

/* ============================================================
 * 五、游戏控制
 * 说明：落子 → 判胜/平局 → 换手 →（人机模式下调用 AI）的主流程都在这里
 * ============================================================ */
/**
 * 初始化：重开一局。mode 缺省时默认双人对战。
 * askGuess=true 表示这次开局需要弹“猜先”弹窗（模式切换 / 重新开始触发）。
 * 格数切换只重建棋盘、保留当前执子约定，不弹窗。 */
function init(mode, askGuess) {
  if (gameMode === MODE_ONLINE && mode !== MODE_ONLINE) onlineLeave();  // 离开在线模式先断开连接
  clearTimeout(aiTimer);            // 取消可能存在的 AI 落子定时器
  if (mode === MODE_ONLINE) {
    // 未加入房间前格数选择器可用：建房时会把当前格数发给服务器作为房间属性
    if (!ws) onlineStatusEl.textContent = '未连接：选好棋盘格数后创建房间，或输入 5 位房间号加入';
  }
  boardSize = parseInt(boardSizeSelect.value, 10);
  board = Array.from({ length: boardSize }, () => Array(boardSize).fill(EMPTY));
  currentPlayer = BLACK;            // 黑棋先手
  gameOver = false;
  gameMode = mode || MODE_PVP;
  moveCount = 0;
  lastMove = null;
  winLine = null;
  moveHistory = [];
  aiTimer = null;
  hintMove = null;
  lastVcfPath = null;               // 新一局清掉上次 VCF 杀棋路径
  lastVctPath = null;               // 新一局清掉上次 VCT 杀棋路径
  clearInterval(teachBlinkTimer);   // 停掉教学危险点闪烁
  teachBlinkTimer = null;
  // 新一局默认“玩家执黑、AI 执白 / 玩家1 执黑”；猜先结果会覆盖这两个变量
  playerColor = BLACK;
  aiColor = WHITE;
  p1Color = BLACK;
  lastOppIntent = null;             // 清掉上一局的对手意图分析
  closeGuessDialog();               // 收起可能存在的本地猜先弹窗
  closeOnlineGuess();               // 收起可能存在的联机猜先弹窗
  resizeCanvas();                   // 画布尺寸随棋盘格数变化
  syncModeButtons();                // 高亮当前模式按钮
  syncControls();                   // 双人模式下禁用 AI 相关控件
  clearComment();                   // 清空教学点评
  updateStatus();
  draw();
  // 双人/人机模式且开启“开局猜先”时，弹窗决定谁执黑谁执白（此时先不启动 AI）
  if (askGuess && guessFirst && (gameMode === MODE_PVP || gameMode === MODE_PVE)) {
    openGuessDialog();
    return;
  }
  // 玩家执白、AI 执黑先行：开局直接调度 AI 首步
  scheduleAiIfNeeded();
}

/**
 * 若当前轮到 AI（人机模式开局 AI 执黑时），安排 AI 首步落子。
 * 猜先结果应用后、以此 init 结束时调用，保证执子颜色变化后 AI 能正常先行。 */
function scheduleAiIfNeeded() {
  if (gameMode === MODE_PVE && !gameOver && currentPlayer === aiColor) {
    clearTimeout(aiTimer);
    aiTimer = setTimeout(aiMove, AI_DELAY);
  }
}

/** 按当前棋盘格数重设画布宽高（19 路最大，约 760px） */
function resizeCanvas() {
  const size = MARGIN * 2 + (boardSize - 1) * CELL_SIZE;
  canvas.width = size;
  canvas.height = size;
}

/**
 * 在 (r, c) 落一颗当前玩家的棋子，并处理后续：
 * 1) 写入数据 → 2) 判胜/平局 → 3) 教学点评 → 4) 换手（人机模式自动触发 AI）。
 * byPlayer 用于区分是玩家落子还是 AI 落子，决定是否触发点评逻辑。 */
function placeStone(r, c) {
  const byPlayer = gameMode === MODE_PVE && currentPlayer === playerColor;

  board[r][c] = currentPlayer;
  hashXor(r, c, currentPlayer);     // 同步维护 Zobrist 棋盘哈希，供困难档置换表使用
  moveHistory.push([r, c]);
  lastMove = [r, c];
  moveCount++;
  draw();

  const line = checkWin(r, c);
  if (line) {                       // 胜负已分
    winLine = line;
    gameOver = true;
    if (byPlayer && eduMode) showPlayerComment('太棒了！这一步直接连成五子，你赢了！');
    updateStatus();
    return;
  }
  if (moveCount === boardSize * boardSize) {  // 棋盘下满 → 平局
    gameOver = true;
    updateStatus();
    return;
  }

  if (byPlayer && eduMode) {
    hintMove = null;                // 玩家落子后清掉旧推荐点，等 AI 应手后再算
    showPlayerComment(analyzePlayerMove(r, c));
    draw();                         // 补绘一次：立刻显示玩家棋型高亮与危险点
  }
  switchPlayer();
}

/**
 * 交换行动方；轮到 AI 时安排定时落子，轮回玩家时刷新推荐点。
 * 推荐点只在“AI 已经应手、轮到玩家”时计算，保证提示针对最新局面。 */
function switchPlayer() {
  currentPlayer = currentPlayer === BLACK ? WHITE : BLACK;
  updateStatus();
  if (gameMode === MODE_PVE && currentPlayer === aiColor) {
    aiTimer = setTimeout(aiMove, AI_DELAY);
  } else if (gameMode === MODE_PVE && currentPlayer === playerColor && eduMode && !gameOver) {
    refreshHint();
  }
}

/**
 * 悔棋：撤销最近一步。
 * - 双人模式：只撤销 1 步；
 * - 人机模式：撤销玩家 1 步 + AI 的应手（共 2 步），回到玩家的回合。
 * - AI 思考中不允许悔棋；
 * - 教育模式下同时清空点评与推荐点，避免与当前局面不符。 */
function undo() {
  if (gameMode === MODE_PVE && currentPlayer === aiColor) return;
  if (moveHistory.length === 0) return;

  clearTimeout(aiTimer);
  if (gameOver) {                   // 终局后悔棋：解除终局状态
    gameOver = false;
    winLine = null;
  }

  if (gameMode === MODE_PVE) {
    const [r, c] = moveHistory.pop();
    const color1 = board[r][c];
    board[r][c] = EMPTY;
    hashXor(r, c, color1);          // 出棋：读盘面颜色后从哈希中异或掉
    moveCount--;
    if (moveHistory.length > 0) {   // 再撤掉 AI 的应手
      const [r2, c2] = moveHistory.pop();
      const color2 = board[r2][c2];
      board[r2][c2] = EMPTY;
      hashXor(r2, c2, color2);      // 出棋：读盘面颜色后从哈希中异或掉
      moveCount--;
    }
    currentPlayer = playerColor;
  } else {
    const [r, c] = moveHistory.pop();
    const color = board[r][c];
    board[r][c] = EMPTY;
    hashXor(r, c, color);           // 出棋：读盘面颜色后从哈希中异或掉
    moveCount--;
    currentPlayer = currentPlayer === BLACK ? WHITE : BLACK;
  }

  lastMove = moveHistory.length ? moveHistory[moveHistory.length - 1] : null;
  hintMove = null;
  clearComment();
  updateStatus();
  if (eduMode && gameMode === MODE_PVE && !gameOver) refreshHint();
  else draw();
}

/** 根据当前状态刷新状态栏文字（回合 / 步数 / 胜负 / 平局） */
function updateStatus() {
  if (gameMode === MODE_ONLINE) {
    updateOnlinePlayers();     // 玩家栏随回合/落子同步
    onlineUpdateControls();    // 落子/换手/终局后同步按钮可用性（如棋盘大小锁定）
  }
  // 再来一局按钮：仅在线模式、对局已结束且双方在线时可用
  if (gameMode === MODE_ONLINE) {
    rematchRow.style.display = (gameOver && onlineReady) ? '' : 'none';
    btnRematch.disabled = !(gameOver && onlineReady && ws && ws.readyState === WebSocket.OPEN);
  } else {
    rematchRow.style.display = 'none';
  }
  updateWinRate();  // 先刷新胜率面板：终局/换手/AI 思考时都同步（currentPlayer=即将行动方）
  if (gameOver) {
    if (winLine) {
      if (gameMode === MODE_ONLINE) {
        // 在线模式：当前行动方（未换手）就是赢家，补充“你赢了/你输了”
        const winnerName = colorName(currentPlayer);
        statusEl.textContent = winnerName + '获胜！' + (currentPlayer === myColor ? '（你赢了）' : '（你输了）');
      } else if (gameMode === MODE_PVE) {
        statusEl.textContent = currentPlayer === playerColor ? '你获胜了！' : 'AI 获胜！';
      } else {
        statusEl.textContent = colorName(currentPlayer) + pvpOwner(currentPlayer) + '获胜！';
      }
    } else {
      statusEl.textContent = '平局';
    }
    return;
  }
  if (gameMode === MODE_PVE && currentPlayer === aiColor) {
    statusEl.textContent = 'AI（' + colorName(aiColor) + '）思考中…';
    return;
  }
  if (gameMode === MODE_ONLINE) {
    if (!onlineReady || !myColor) {   // 未就绪（未加入房间 / 猜先中 / 对方未到）：复用面板状态文字
      statusEl.textContent = onlineStatusEl.textContent || '在线对战中…';
      return;
    }
    const name = colorName(currentPlayer);
    statusEl.textContent = currentPlayer === myColor
      ? '你的回合（' + name + '）· 第 ' + moveCount + ' 手'
      : '等待对方（' + name + '）落子…';
    return;
  }
  const name = colorName(currentPlayer);
  // 双人模式显示“玩家1/玩家2”，人机模式显示“（你）”——执子颜色由猜先决定
  const owner = gameMode === MODE_PVE ? '（你）' : pvpOwner(currentPlayer);
  statusEl.textContent = name + owner + '回合 · 第 ' + moveCount + ' 手';
}

