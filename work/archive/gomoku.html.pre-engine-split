/* ============================================================
 * 十一、游戏注册与启动
 * 说明：把五子棋包装成 GameAdapter 注册进框架。国际象棋、围棋、
 * 中国象棋的预留骨架见 games/ 目录，实现后同样 registerGame 即可。
 * ============================================================ */

/** 五子棋适配器：字段含义见“零、扩展接口”的说明 */
const gomokuAdapter = {
  id: 'gomoku',
  name: '五子棋',
  modes: [MODE_PVP, MODE_PVE, MODE_ONLINE],
  boardSizes: BOARD_SIZES,
  defaultBoardSize: DEFAULT_BOARD_SIZE,
  aiLevels: { easy: '简单', medium: '中等', hard: '困难' },
  defaultAiLevel: LEVEL_MEDIUM,
  supportsEdu: true,

  /** 进入五子棋：按当前模式重开一局，并询问“开局猜先” */
  onEnter() { init(gameMode, true); },

  /** 切走前取消未执行的 AI 落子定时器、收起猜先弹窗，并断开在线连接 */
  onExit() {
    clearTimeout(aiTimer);
    clearInterval(teachBlinkTimer);
    teachBlinkTimer = null;
    lastVcfPath = null;
    lastVctPath = null;
    closeGuessDialog();
    if (ws) onlineLeave();
    onlinePanel.style.display = 'none';
  },

  onCanvasClick: gomokuCanvasClick,
  onUndo: undo,
  onRestart() { init(gameMode, true); },
  onModeChange(mode) {
    // 已在在线房间中时，再次点击“在线对战”不重开，避免与服务器不同步
    if (mode === MODE_ONLINE && ws && (ws.readyState === WebSocket.OPEN || ws.readyState === WebSocket.CONNECTING)) return;
    init(mode, true);
  },
  onBoardSizeChange() { init(gameMode, false); },  // 换格数只重开棋盘，不重新猜先

  /** AI 难度变化：不影响进行中的棋局，只影响之后的 AI 落子与推荐点 */
  onAiLevelChange(level) {
    aiLevel = level;
    hintMove = null;
    clearComment();
    if (eduMode && gameMode === MODE_PVE && currentPlayer === playerColor && !gameOver) {
      refreshHint();
    } else {
      draw();
    }
  },

  /** 教学点评开关 */
  onEduToggle(checked) {
    eduMode = checked;
    clearComment();
    if (!eduMode) {
      hintMove = null;
      draw();
      return;
    }
    if (gameMode === MODE_PVE && currentPlayer === playerColor && !gameOver) {
      refreshHint();
    } else {
      draw();
    }
  },

  /** 推荐点开关 */
  onHintToggle(checked) {
    showHint = checked;
    if (showHint && eduMode && gameMode === MODE_PVE && currentPlayer === playerColor && !gameOver) {
      refreshHint();
    } else {
      hintMove = null;
      draw();
    }
  },
};

// 注册五子棋并启动；页面默认进入双人对战、19 路棋盘
