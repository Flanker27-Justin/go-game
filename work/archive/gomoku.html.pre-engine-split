// 配合 cpolar 公网地址，朋友在微信里点开链接即可直接入局，无需手动输入房间号。
(function autoJoinByInvite() {
  const params = new URLSearchParams(location.search);
  const inviteRoom = params.get('room') || params.get('invite');
  if (!inviteRoom || !/^[A-Z0-9]{5}$/i.test(inviteRoom)) return;
  const code = inviteRoom.toUpperCase();
  btnOnline.click();                    // 进入在线对战模式（保留房间号输入框可用状态）
  roomCodeInput.value = code;
  // 若本标签页已有该房间的会话（刷新页面/断线后重开），应重连恢复局面，而不是重复加入
  const saved = loadOnlineSession();
  if (saved && saved.room === code) {
    onlineConnect('reconnect', saved.room, saved.token);
    return;
  }
  onlineConnect('join', code);
})();

// 刷新页面自动回房：同标签页断线/刷新后，用上次会话凭证自动重连（有邀请参数时交给 autoJoinByInvite）
(function autoRejoin() {
  const params = new URLSearchParams(location.search);
  if (params.get('room') || params.get('invite')) return;
  const s = loadOnlineSession();
  if (!s) return;
  btnOnline.click();                    // 进入在线对战模式
  onlineConnect('reconnect', s.room, s.token);
})();
